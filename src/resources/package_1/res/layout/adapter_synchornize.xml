<?xml version='1.0' encoding='utf-8' ?>
<FrameLayout android:orientation="horizontal"
             android:background="@color/white"
             android:layout_width="fill_parent"
             android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <ImageView android:id="@id/img"
                 android:layout_width="0.0dp"
                 android:layout_height="60.0dp"
                 android:layout_margin="10.0dp"
                 android:scaleType="fitCenter"
                 android:maxHeight="60.0dp"
                 android:layout_weight="0.3" />
      <LinearLayout android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7">
        <TextView android:textSize="16.0sp"
                  android:textColor="#ff000000"
                  android:ellipsize="end"
                  android:id="@id/tv_filename"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="10.0dp"
                  android:layout_marginTop="8.0dp"
                  android:layout_marginRight="10.0dp"
                  android:maxLines="2"
                  android:lines="2" />
        <LinearLayout android:gravity="center_vertical"
                      android:orientation="horizontal"
                      android:id="@id/ll_progress"
                      android:visibility="visible"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginLeft="10.0dp"
                      android:layout_marginTop="5.0dp"
                      android:layout_marginRight="10.0dp"
                      android:layout_marginBottom="5.0dp">
          <ProgressBar android:id="@id/progressBar"
                       android:layout_width="0.0dp"
                       android:layout_height="2.0dp"
                       android:max="100"
                       android:layout_weight="1.0"
                       style="?android:attr/progressBarStyleHorizontal" />
          <com.kingagroot.kingdraw.widget.DoneView android:id="@id/view_status"
                                android:layout_width="20.0dp"
                                android:layout_height="20.0dp"
                                android:layout_marginLeft="10.0dp" />
        </LinearLayout>
        <TextView android:textSize="14.0sp"
                  android:textColor="@color/gray_un_select"
                  android:id="@id/tv_wait"
                  android:visibility="gone"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="10.0dp"
                  android:layout_marginTop="5.0dp"
                  android:layout_marginBottom="5.0dp"
                  android:text="@string/synchronize_waiting" />
      </LinearLayout>
    </LinearLayout>
    <View android:background="@color/line"
          android:layout_width="fill_parent"
          android:layout_height="1.0dp" />
  </LinearLayout>
</FrameLayout>