<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:background="@android:color/transparent"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@android:color/white"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="50.0dp">
    <com.goodsrc.ui.library.widget.ClearEditText android:textSize="15.0sp"
                          android:gravity="center|left"
                          android:id="@id/et_text"
                          android:background="@null"
                          android:paddingLeft="10.0dp"
                          android:paddingTop="8.0dp"
                          android:paddingRight="10.0dp"
                          android:paddingBottom="8.0dp"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:maxLines="1"
                          android:singleLine="true"
                          android:layout_weight="1.0"
                          android:imeOptions="flagNoExtractUi" />
    <TextView android:id="@id/tv_count"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
    <TextView android:textColor="@color/colorRed"
              android:gravity="center_vertical"
              android:id="@id/tv_cancel"
              android:paddingLeft="10.0dp"
              android:paddingRight="10.0dp"
              android:layout_width="wrap_content"
              android:layout_height="45.0dp"
              android:text="@string/cancel" />
    <TextView android:textColor="@drawable/edit_pop_confirm_color_selector"
              android:gravity="center_vertical"
              android:id="@id/tv_sure"
              android:paddingLeft="10.0dp"
              android:paddingRight="10.0dp"
              android:layout_width="wrap_content"
              android:layout_height="45.0dp"
              android:text="@string/confirm" />
  </LinearLayout>
</LinearLayout>