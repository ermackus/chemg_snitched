<?xml version='1.0' encoding='utf-8' ?>
<FrameLayout android:orientation="vertical"
             android:background="@color/white"
             android:layout_width="fill_parent"
             android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <RelativeLayout android:layout_width="fill_parent"
                  android:layout_height="45.0dp"
                  android:paddingStart="10.0dp"
                  android:paddingEnd="10.0dp">
    <ImageButton android:id="@id/ibt_back"
                 android:background="@android:color/transparent"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_centerVertical="true"
                 android:layout_alignParentStart="true"
                 kingdraw:srcCompat="@drawable/ic_nav_back" />
    <TextView android:textSize="17.0sp"
              android:textColor="@color/black"
              android:ellipsize="end"
              android:gravity="center|start"
              android:id="@id/tv_pedia_title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:lines="1"
              android:layout_centerInParent="true"
              android:layout_marginStart="10.0dp"
              android:layout_marginEnd="10.0dp"
              android:layout_toStartOf="@id/ll_operation"
              android:layout_toEndOf="@id/ibt_back" />
    <LinearLayout android:orientation="horizontal"
                  android:id="@id/ll_operation"
                  android:background="@drawable/bg_round_color_white_radius_50"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_centerVertical="true"
                  android:paddingStart="10.0dp"
                  android:paddingEnd="10.0dp"
                  android:layout_alignParentEnd="true">
      <ImageButton android:id="@id/ibt_pedia_hide"
                   android:background="?android:attr/selectableItemBackgroundBorderless"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_margin="5.0dp"
                   kingdraw:srcCompat="@drawable/ic_pedia_hide" />
      <View android:layout_gravity="center"
            android:background="#33000000"
            android:layout_width="1.0dp"
            android:layout_height="20.0dp" />
      <ImageButton android:id="@id/ibt_pedia_close"
                   android:background="?android:attr/selectableItemBackgroundBorderless"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_margin="5.0dp"
                   kingdraw:srcCompat="@drawable/ic_pedia_close" />
    </LinearLayout>
  </RelativeLayout>
  <FrameLayout android:id="@id/fl_pedia"
               android:layout_width="fill_parent"
               android:layout_height="fill_parent"
               android:layout_marginTop="40.0dp" />
</FrameLayout>