<?xml version='1.0' encoding='utf-8' ?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape>
      <corners android:topLeftRadius="3.0dp"
               android:topRightRadius="3.0dp"
               android:bottomLeftRadius="3.0dp"
               android:bottomRightRadius="3.0dp" />
      <solid android:color="@color/white" />
      <stroke android:width="1.0dp"
              android:color="#e3e3e3" />
    </shape>
  </item>
  <item android:state_enabled="false">
    <shape>
      <corners android:topLeftRadius="3.0dp"
               android:topRightRadius="3.0dp"
               android:bottomLeftRadius="3.0dp"
               android:bottomRightRadius="3.0dp" />
      <solid android:color="#afafaf" />
    </shape>
  </item>
  <item>
    <shape>
      <corners android:topLeftRadius="3.0dp"
               android:topRightRadius="3.0dp"
               android:bottomLeftRadius="3.0dp"
               android:bottomRightRadius="3.0dp" />
      <solid android:color="@color/white" />
      <stroke android:width="1.0dp"
              android:color="#e3e3e3" />
    </shape>
  </item>
</selector>