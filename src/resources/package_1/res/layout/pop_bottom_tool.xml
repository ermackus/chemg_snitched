<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <FrameLayout android:id="@id/fl_common_tool"
               android:background="@drawable/bg_tool_pop"
               android:layout_width="fill_parent"
               android:layout_height="44.0dp">
    <androidx.recyclerview.widget.RecyclerView android:id="@id/view_tools"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent"
                          android:paddingStart="2.0dp"
                          android:paddingEnd="2.0dp" />
    <ImageView android:layout_gravity="start"
               android:layout_width="30.0dp"
               android:layout_height="fill_parent"
               android:src="@drawable/bg_frame_left"
               android:layout_marginStart="1.0dp" />
    <ImageView android:layout_gravity="end"
               android:layout_width="30.0dp"
               android:layout_height="fill_parent"
               android:src="@drawable/bg_frame_right"
               android:layout_marginEnd="1.0dp" />
  </FrameLayout>
  <RelativeLayout android:id="@id/rl_more_color"
                  android:background="@drawable/bg_tool_pop"
                  android:layout_width="fill_parent"
                  android:layout_height="44.0dp">
    <androidx.recyclerview.widget.RecyclerView android:id="@id/list_color"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent"
                          android:layout_centerVertical="true"
                          android:layout_marginStart="2.0dp"
                          android:layout_toStartOf="@id/iv_line" />
    <ImageView android:id="@id/iv_line"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@mipmap/line_function"
               android:layout_centerVertical="true"
               android:layout_toStartOf="@id/fl_custom" />
    <FrameLayout android:id="@id/fl_custom"
                 android:background="@android:color/white"
                 android:layout_width="@dimen/home_tool_height"
                 android:layout_height="fill_parent"
                 android:layout_centerVertical="true"
                 android:layout_marginEnd="2.0dp"
                 android:layout_alignParentEnd="true">
      <TextView android:textSize="8.0sp"
                android:textColor="#333333"
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="@string/color_custom"
                android:lines="1"
                android:singleLine="true" />
      <com.kingagroot.component.ui.view.RotateTextView android:id="@id/custom"
                            android:background="@drawable/bg_frame_black"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_margin="2.0dp" />
    </FrameLayout>
  </RelativeLayout>
</LinearLayout>