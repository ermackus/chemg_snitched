<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:background="#21201e"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <androidx.core.widget.NestedScrollView android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="-10.0dp"
                        android:layout_above="@id/rl_pay">
    <LinearLayout android:orientation="vertical"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <RelativeLayout android:id="@id/rl_vip_center"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">
        <ImageView android:id="@id/imageView2"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="22.0dp"
                   android:layout_marginEnd="22.0dp"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_vip_crown" />
        <LinearLayout android:orientation="horizontal"
                      android:id="@id/ll_user_info"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="22.0dp"
                      android:layout_marginBottom="15.0dp"
                      android:layout_marginStart="22.0dp">
          <com.goodsrc.ui.library.widget.RoundAndCircleImageView android:id="@id/iv_user_pic"
                                android:background="@android:color/transparent"
                                android:layout_width="60.0dp"
                                android:layout_height="60.0dp"
                                kingdraw:srcCompat="@drawable/ic_user_login" />
          <LinearLayout android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="60.0dp"
                        android:weightSum="2.0"
                        android:layout_marginStart="10.0dp">
            <TextView android:textSize="16.0sp"
                      android:textColor="#ffffffff"
                      android:ellipsize="end"
                      android:gravity="bottom"
                      android:id="@id/tv_user_name"
                      android:layout_width="wrap_content"
                      android:layout_height="0.0dp"
                      android:lines="1"
                      android:layout_weight="1.0" />
            <TextView android:textSize="11.0sp"
                      android:textColor="#ffaaaaaa"
                      android:id="@id/tv_user_type"
                      android:layout_width="wrap_content"
                      android:layout_height="0.0dp"
                      android:layout_weight="1.0" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical"
                      android:background="@0x7f080183"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      android:layout_below="@id/ll_user_info"
                      android:layout_marginStart="22.0dp"
                      android:layout_marginEnd="22.0dp">
          <RelativeLayout android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:layout_marginTop="14.0dp"
                          android:layout_marginStart="20.0dp"
                          android:layout_marginEnd="20.0dp">
            <ImageView android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       kingdraw:srcCompat="@0x7f080252" />
            <TextView android:textSize="12.0sp"
                      android:textColor="#ff6f3b2a"
                      android:gravity="center"
                      android:id="@id/tv_vip_check_all"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="@string/vip_equity"
                      android:drawableEnd="@drawable/ic_center_next"
                      android:layout_alignParentEnd="true" />
          </RelativeLayout>
          <GridView android:id="@id/gv_vip_center"
                    android:clickable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:listSelector="@android:color/transparent"
                    android:numColumns="4" />
        </LinearLayout>
      </RelativeLayout>
      <LinearLayout android:orientation="vertical"
                    android:background="@drawable/bg_white_top_radius_20"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
        <TextView android:textSize="16.0sp"
                  android:textColor="#ff333333"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="20.0dp"
                  android:text="@string/vip_pay_way"
                  android:layout_marginStart="16.0dp" />
        <GridView android:id="@id/gv_pay_way"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="10.0dp"
                  android:numColumns="2"
                  android:layout_marginStart="16.0dp"
                  android:layout_marginEnd="16.0dp" />
        <TextView android:textSize="10.0sp"
                  android:textColor="#ffaaaaaa"
                  android:id="@id/tv_vip_agreement"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6.0dp"
                  android:text="@string/vip_pay_agreement"
                  android:layout_marginStart="16.0dp" />
        <TextView android:textSize="16.0sp"
                  android:textColor="#ff333333"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="20.0dp"
                  android:text="@string/vip_plan"
                  android:layout_marginStart="16.0dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@id/rv_vip_plan"
                              android:scrollbars="none"
                              android:layout_width="fill_parent"
                              android:layout_height="fill_parent"
                              android:layout_marginTop="6.0dp"
                              android:layout_marginStart="16.0dp"
                              android:layout_marginEnd="16.0dp" />
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <RelativeLayout android:id="@id/rl_pay"
                  android:background="@drawable/bg_round_top_white_5"
                  android:layout_width="fill_parent"
                  android:layout_height="100.0dp"
                  android:layout_marginBottom="-1.0dp"
                  android:layout_alignParentBottom="true"
                  android:layout_marginEnd="-1.0dp"
                  android:layout_alignParentEnd="true">
    <Button android:textSize="16.0sp"
            android:textColor="#ffffffff"
            android:id="@id/btn_pay"
            android:background="@drawable/bg_pay_selector"
            android:layout_width="130.0dp"
            android:layout_height="34.0dp"
            android:text="@string/open_vip"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16.0dp"
            android:layout_alignParentEnd="true" />
    <LinearLayout android:orientation="vertical"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_centerVertical="true"
                  android:layout_marginStart="16.0dp">
      <LinearLayout android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
        <TextView android:textSize="15.0sp"
                  android:textColor="#ffff5352"
                  android:id="@id/tv_money_type"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content" />
        <TextView android:textSize="30.0sp"
                  android:textStyle="bold"
                  android:textColor="#ffff5352"
                  android:id="@id/tv_money"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content" />
      </LinearLayout>
      <TextView android:textSize="11.0sp"
                android:textColor="#ff333333"
                android:id="@id/tv_money_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
    </LinearLayout>
  </RelativeLayout>
</RelativeLayout>