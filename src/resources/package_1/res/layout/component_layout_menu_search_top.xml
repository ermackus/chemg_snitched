<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:gravity="center_vertical"
              android:orientation="horizontal"
              android:layout_width="fill_parent"
              android:layout_height="@dimen/home_tool_height"
              android:baselineAligned="false" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:gravity="center_vertical"
                android:id="@id/ll_content"
                android:background="@drawable/func_top_bg"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">
    <LinearLayout android:gravity="center"
                  android:id="@id/ll_left"
                  android:layout_width="wrap_content"
                  android:layout_height="fill_parent"
                  android:paddingEnd="5.0dp"
                  android:layout_marginStart="15.0dp">
      <Button android:textSize="12.0sp"
              android:textColor="@android:color/white"
              android:id="@id/btn_done"
              android:background="@drawable/btn_usual_selector"
              android:layout_width="60.0dp"
              android:layout_height="30.0dp"
              android:text="@string/done" />
      <Button android:textSize="12.0sp"
              android:textColor="#666666"
              android:id="@id/btn_cancel"
              android:background="@drawable/btn_bg_white"
              android:layout_width="60.0dp"
              android:layout_height="30.0dp"
              android:text="@string/cancel"
              android:layout_marginStart="5.0dp" />
      <ImageView android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:src="@mipmap/line_function" />
    </LinearLayout>
    <HorizontalScrollView android:scrollbars="none"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent"
                          android:fillViewport="true">
      <com.kingagroot.component.ui.menu.TopMenu android:id="@id/menu"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent" />
    </HorizontalScrollView>
  </LinearLayout>
  <ImageView android:layout_width="wrap_content"
             android:layout_height="fill_parent"
             android:src="@mipmap/line_function" />
  <CheckBox android:id="@id/cb_full_screen"
            android:background="@drawable/func_top_bg"
            android:layout_width="@dimen/home_tool_height"
            android:layout_height="@dimen/home_tool_height"
            android:button="@drawable/checkbox_fullscreen_selector" />
</LinearLayout>