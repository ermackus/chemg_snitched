<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:background="#f8f8f8"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <TextView android:textSize="18.0sp"
            android:textColor="#333333"
            android:gravity="center|left"
            android:layout_width="fill_parent"
            android:layout_height="48.0dp"
            android:text="@string/gateway"
            android:paddingStart="10.0dp" />
  <LinearLayout android:orientation="horizontal"
                android:background="@color/white"
                android:layout_width="fill_parent"
                android:layout_height="48.0dp"
                android:paddingStart="10.0dp"
                android:paddingEnd="10.0dp">
    <TextView android:textSize="16.0sp"
              android:textColor="#ff333333"
              android:layout_width="0.0dp"
              android:layout_height="wrap_content"
              android:text="@string/gateway_switch"
              android:layout_weight="0.7" />
    <androidx.appcompat.widget.SwitchCompat android:id="@id/switch_gateway"
                          android:layout_width="0.0dp"
                          android:layout_height="fill_parent"
                          android:checked="true"
                          android:layout_weight="0.3" />
  </LinearLayout>
  <LinearLayout android:orientation="vertical"
                android:id="@id/ll_gateway_info"
                android:background="@color/white"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <View android:background="#d9d9d9"
          android:layout_width="fill_parent"
          android:layout_height="1.0dp" />
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="48.0dp"
                  android:paddingStart="10.0dp"
                  android:paddingEnd="10.0dp">
      <TextView android:textSize="16.0sp"
                android:textColor="#ff333333"
                android:gravity="center|left"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:text="@string/gateway_ip"
                android:layout_weight="0.3"
                android:lineSpacingExtra="12.0dp" />
      <EditText android:textSize="16.0sp"
                android:textColor="#ffcccccc"
                android:id="@id/et_gateway_ip"
                android:background="@color/white"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:hint="@string/gateway_ip_hint"
                android:digits="0123456789."
                android:layout_weight="0.7"
                android:inputType="numberDecimal" />
    </LinearLayout>
    <View android:background="#d9d9d9"
          android:layout_width="fill_parent"
          android:layout_height="1.0dp"
          android:layout_marginStart="10.0dp"
          android:layout_marginEnd="10.0dp" />
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="48.0dp"
                  android:paddingStart="10.0dp"
                  android:paddingEnd="10.0dp">
      <TextView android:textSize="16.0sp"
                android:textColor="#ff333333"
                android:gravity="center|left"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:text="@string/gateway_port"
                android:layout_weight="0.3"
                android:lineSpacingExtra="12.0dp" />
      <EditText android:textSize="16.0sp"
                android:textColor="#ffcccccc"
                android:id="@id/et_gateway_port"
                android:background="@color/white"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:hint="@string/gateway_port_hint"
                android:digits="0123456789"
                android:layout_weight="0.7"
                android:inputType="number" />
    </LinearLayout>
    <View android:background="#d9d9d9"
          android:layout_width="fill_parent"
          android:layout_height="1.0dp"
          android:layout_marginStart="10.0dp"
          android:layout_marginEnd="10.0dp" />
    <TextView android:textSize="14.0sp"
              android:textColor="#ffff0303"
              android:id="@id/tv_gateway_err"
              android:visibility="gone"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:layout_margin="10.0dp" />
    <androidx.appcompat.widget.AppCompatButton android:textSize="16.0sp"
                          android:textColor="@color/white"
                          android:id="@id/btn_gateway_test"
                          android:background="@drawable/btn_usual_selector"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:layout_margin="10.0dp"
                          android:text="@string/gateway_test" />
  </LinearLayout>
</LinearLayout>