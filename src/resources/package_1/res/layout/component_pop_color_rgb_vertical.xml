<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:background="@drawable/bg_round_rectangle_gray"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
    <com.kingagroot.component.ui.widget.colorpicker.ColorPicker android:id="@id/picker_color"
                          android:layout_width="160.0dp"
                          android:layout_height="160.0dp" />
    <com.kingagroot.component.ui.widget.colorpicker.SVBar android:id="@id/sv_bar"
                          android:layout_width="140.0dp"
                          android:layout_height="180.0dp"
                          android:layout_marginBottom="15.0dp" />
  </LinearLayout>
  <LinearLayout android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="220.0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.0dp"
                android:layout_marginBottom="10.0dp"
                android:layout_marginStart="10.0dp"
                android:layout_marginEnd="10.0dp">
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <TextView android:textSize="14.0sp"
                android:textColor="@color/black"
                android:gravity="center|start"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:text="@string/color_red"
                android:layout_weight="0.3" />
      <EditText android:textSize="14.0sp"
                android:textColor="#717171"
                android:gravity="center"
                android:id="@id/et_color_r"
                android:background="@drawable/bg_rect_rectangle_white"
                android:padding="5.0dp"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:maxLength="3"
                android:layout_weight="0.7"
                android:inputType="number"
                android:imeOptions="flagNoExtractUi" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="10.0dp">
      <TextView android:textSize="14.0sp"
                android:textColor="@color/black"
                android:gravity="center|start"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:text="@string/color_green"
                android:layout_weight="0.3" />
      <EditText android:textSize="14.0sp"
                android:textColor="#717171"
                android:gravity="center"
                android:id="@id/et_color_g"
                android:background="@drawable/bg_rect_rectangle_white"
                android:padding="5.0dp"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:maxLength="3"
                android:layout_weight="0.7"
                android:inputType="number"
                android:imeOptions="flagNoExtractUi" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="10.0dp">
      <TextView android:textSize="14.0sp"
                android:textColor="@color/black"
                android:gravity="center|start"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:text="@string/color_blue"
                android:layout_weight="0.3" />
      <EditText android:textSize="14.0sp"
                android:textColor="#717171"
                android:gravity="center"
                android:id="@id/et_color_b"
                android:background="@drawable/bg_rect_rectangle_white"
                android:padding="5.0dp"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:maxLength="3"
                android:layout_weight="0.7"
                android:inputType="number"
                android:imeOptions="flagNoExtractUi" />
    </LinearLayout>
    <View android:background="#d9d9d9"
          android:layout_width="fill_parent"
          android:layout_height="1.0dp"
          android:layout_marginTop="10.0dp" />
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="10.0dp">
      <TextView android:textSize="14.0sp"
                android:textColor="@color/black"
                android:gravity="center|start"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/color_value"
                android:lines="1" />
      <TextView android:textSize="12.0sp"
                android:textColor="#333333"
                android:gravity="center_horizontal"
                android:id="@id/tv_color"
                android:background="@drawable/bg_rect_rectangle_gray"
                android:padding="5.0dp"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:lines="1"
                android:textAllCaps="true"
                android:layout_marginStart="5.0dp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>