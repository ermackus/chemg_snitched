<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:background="#fff5f5f5"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <RelativeLayout android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="40.0dp"
                  android:layout_marginBottom="2.0dp">
    <TextView android:textSize="14.0sp"
              android:textColor="#484848"
              android:id="@id/tv_model_title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginLeft="15.0dp"
              android:text="@string/template"
              android:layout_alignParentLeft="true"
              android:layout_centerVertical="true"
              android:layout_marginStart="15.0dp"
              android:layout_alignParentStart="true" />
    <ImageView android:id="@id/iv_next"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginRight="10.0dp"
               android:layout_alignParentRight="true"
               android:layout_centerVertical="true"
               android:contentDescription="@string/next"
               android:layout_marginEnd="10.0dp"
               android:layout_alignParentEnd="true"
               kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
    <TextView android:textSize="12.0sp"
              android:textColor="#333333"
              android:gravity="center|right"
              android:id="@id/tv_template"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:text="@string/user_format"
              android:layout_toLeftOf="@id/iv_next"
              android:layout_toRightOf="@id/tv_model_title"
              android:layout_centerVertical="true"
              android:layout_toStartOf="@id/iv_next" />
  </RelativeLayout>
  <ScrollView android:layout_width="fill_parent"
              android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical"
                  android:background="#fff5f5f5"
                  android:focusable="true"
                  android:focusableInTouchMode="true"
                  android:layout_width="fill_parent"
                  android:layout_height="fill_parent">
      <LinearLayout android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content"
                  android:text="@string/bonds_setting"
                  style="@style/Setting_tv_out" />
        <ImageButton android:id="@id/imbtn_bonds_help"
                     android:background="@null"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     kingdraw:srcCompat="@drawable/ic_format_btn_set_help_nor" />
      </LinearLayout>
      <LinearLayout android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <LinearLayout style="@style/Setting_layout">
          <TextView android:textSize="14.0sp"
                    android:textColor="#ff484848"
                    android:gravity="center_vertical"
                    android:paddingLeft="15.0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="@string/fixed_length"
                    android:paddingStart="15.0dp" />
          <TextView android:textSize="12.0sp"
                    android:textColor="#ff999999"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="5.0dp"
                    android:text="@string/fixed_length_interval"
                    android:layout_marginStart="5.0dp" />
          <com.kingagroot.kingdraw.widget.RegionNumberEditText android:textSize="12.0sp"
                                android:textColor="#999999"
                                android:gravity="center|end"
                                android:layout_gravity="end"
                                android:id="@id/et_fixed_length"
                                android:background="@color/white"
                                android:paddingRight="15.0dp"
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:maxLength="9"
                                android:inputType="numberDecimal"
                                android:paddingEnd="15.0dp" />
        </LinearLayout>
        <View android:layout_marginLeft="15.0dp"
              android:layout_marginStart="15.0dp"
              style="@style/hline" />
        <LinearLayout style="@style/Setting_layout">
          <TextView android:textSize="14.0sp"
                    android:textColor="#ff484848"
                    android:gravity="center_vertical"
                    android:paddingLeft="15.0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="@string/spacing" />
          <TextView android:textSize="12.0sp"
                    android:textColor="#ff999999"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="5.0dp"
                    android:text="@string/spacing_interval"
                    android:layout_marginStart="5.0dp" />
          <com.kingagroot.kingdraw.widget.RegionNumberEditText android:textSize="12.0sp"
                                android:textColor="#999999"
                                android:gravity="center|right"
                                android:layout_gravity="end"
                                android:id="@id/et_spacing"
                                android:background="@color/white"
                                android:paddingRight="15.0dp"
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:maxLength="3"
                                android:inputType="number" />
        </LinearLayout>
        <View android:layout_marginLeft="15.0dp"
              android:layout_marginStart="15.0dp"
              style="@style/hline" />
        <LinearLayout style="@style/Setting_layout">
          <TextView android:textSize="14.0sp"
                    android:textColor="#ff484848"
                    android:gravity="center_vertical"
                    android:paddingLeft="15.0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="@string/line_width" />
          <TextView android:textSize="12.0sp"
                    android:textColor="#ff999999"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="5.0dp"
                    android:text="@string/line_width_interval"
                    android:layout_marginStart="5.0dp" />
          <com.kingagroot.kingdraw.widget.RegionNumberEditText android:textSize="12.0sp"
                                android:textColor="#999999"
                                android:gravity="center|right"
                                android:layout_gravity="end"
                                android:id="@id/et_line_width"
                                android:background="@color/white"
                                android:paddingRight="15.0dp"
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:maxLength="8"
                                android:inputType="numberDecimal" />
        </LinearLayout>
        <View android:layout_marginLeft="15.0dp"
              android:layout_marginStart="15.0dp"
              style="@style/hline" />
        <LinearLayout style="@style/Setting_layout">
          <TextView android:textSize="14.0sp"
                    android:textColor="#ff484848"
                    android:gravity="center_vertical"
                    android:paddingLeft="15.0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="@string/bold_width" />
          <TextView android:textSize="12.0sp"
                    android:textColor="#ff999999"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="5.0dp"
                    android:text="@string/bold_width_interval"
                    android:layout_marginStart="5.0dp" />
          <com.kingagroot.kingdraw.widget.RegionNumberEditText android:textSize="12.0sp"
                                android:textColor="#999999"
                                android:gravity="center|right"
                                android:layout_gravity="end"
                                android:id="@id/et_bold_width"
                                android:background="@color/white"
                                android:paddingRight="15.0dp"
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:maxLength="8"
                                android:inputType="numberDecimal" />
        </LinearLayout>
        <View android:layout_marginLeft="15.0dp"
              android:layout_marginStart="15.0dp"
              style="@style/hline" />
        <LinearLayout style="@style/Setting_layout">
          <TextView android:textSize="14.0sp"
                    android:textColor="#ff484848"
                    android:gravity="center_vertical"
                    android:paddingLeft="15.0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="@string/margin_width" />
          <TextView android:textSize="12.0sp"
                    android:textColor="#ff999999"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="5.0dp"
                    android:text="@string/margin_width_interval"
                    android:layout_marginStart="5.0dp" />
          <com.kingagroot.kingdraw.widget.RegionNumberEditText android:textSize="12.0sp"
                                android:textColor="#999999"
                                android:gravity="center|right"
                                android:layout_gravity="end"
                                android:id="@id/et_margin_width"
                                android:background="@color/white"
                                android:paddingRight="15.0dp"
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:maxLength="8"
                                android:inputType="numberDecimal" />
        </LinearLayout>
        <View android:layout_marginLeft="15.0dp"
              android:layout_marginStart="15.0dp"
              style="@style/hline" />
        <LinearLayout style="@style/Setting_layout">
          <TextView android:textSize="14.0sp"
                    android:textColor="#ff484848"
                    android:gravity="center_vertical"
                    android:paddingLeft="15.0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="@string/hash_spacing" />
          <TextView android:textSize="12.0sp"
                    android:textColor="#ff999999"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="5.0dp"
                    android:text="@string/hash_spacing_interval"
                    android:layout_marginStart="5.0dp" />
          <com.kingagroot.kingdraw.widget.RegionNumberEditText android:textSize="12.0sp"
                                android:textColor="#999999"
                                android:gravity="center|right"
                                android:layout_gravity="end"
                                android:id="@id/et_hash_spacing"
                                android:background="@color/white"
                                android:paddingRight="15.0dp"
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:maxLength="8"
                                android:inputType="numberDecimal" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content"
                  android:text="@string/chains_setting"
                  style="@style/Setting_tv_out" />
        <ImageButton android:id="@id/imbtn_chains_help"
                     android:background="@null"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     kingdraw:srcCompat="@drawable/ic_format_btn_set_help_pre" />
      </LinearLayout>
      <LinearLayout style="@style/Setting_layout">
        <TextView android:textSize="14.0sp"
                  android:textColor="#ff484848"
                  android:gravity="center_vertical"
                  android:paddingLeft="15.0dp"
                  android:layout_width="wrap_content"
                  android:layout_height="fill_parent"
                  android:text="@string/angle" />
        <TextView android:textSize="12.0sp"
                  android:textColor="#ff999999"
                  android:gravity="center_vertical"
                  android:layout_width="wrap_content"
                  android:layout_height="fill_parent"
                  android:layout_marginLeft="5.0dp"
                  android:text="@string/angle_interval"
                  android:layout_marginStart="5.0dp" />
        <com.kingagroot.kingdraw.widget.RegionNumberEditText android:textSize="12.0sp"
                              android:textColor="#999999"
                              android:gravity="center|right"
                              android:layout_gravity="end"
                              android:id="@id/et_angle"
                              android:background="@color/white"
                              android:paddingRight="15.0dp"
                              android:layout_width="fill_parent"
                              android:layout_height="fill_parent"
                              android:maxLength="3"
                              android:inputType="number" />
      </LinearLayout>
      <TextView android:text="@string/atom_labels"
                style="@style/Setting_tv_out" />
      <LinearLayout android:orientation="horizontal"
                    android:id="@id/ll_atom_font_select"
                    android:background="@color/white"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical"
                      android:background="@color/white"
                      android:layout_width="0.0dp"
                      android:layout_height="fill_parent"
                      android:layout_marginLeft="15.0dp"
                      android:layout_marginTop="5.0dp"
                      android:layout_marginBottom="5.0dp"
                      android:layout_weight="0.5"
                      android:layout_marginStart="15.0dp">
          <TextView android:textSize="12.0sp"
                    android:textColor="#666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/font" />
          <TextView android:textSize="16.0sp"
                    android:textColor="#999999"
                    android:id="@id/tv_atom_font_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical"
                      android:background="@color/white"
                      android:layout_width="0.0dp"
                      android:layout_height="fill_parent"
                      android:layout_marginTop="5.0dp"
                      android:layout_marginBottom="5.0dp"
                      android:layout_weight="0.4">
          <TextView android:textSize="12.0sp"
                    android:textColor="#666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/style" />
          <TextView android:textSize="16.0sp"
                    android:textColor="#999999"
                    android:id="@id/tv_atom_font_style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical"
                      android:background="@color/white"
                      android:layout_width="0.0dp"
                      android:layout_height="fill_parent"
                      android:layout_marginTop="5.0dp"
                      android:layout_marginRight="15.0dp"
                      android:layout_marginBottom="5.0dp"
                      android:layout_weight="0.1"
                      android:layout_marginEnd="15.0dp">
          <TextView android:textSize="12.0sp"
                    android:textColor="#666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/size" />
          <TextView android:textSize="16.0sp"
                    android:textColor="#999999"
                    android:id="@id/tv_atom_font_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dp" />
        </LinearLayout>
      </LinearLayout>
      <TextView android:text="@string/text_captions"
                style="@style/Setting_tv_out" />
      <LinearLayout android:orientation="horizontal"
                    android:id="@id/ll_text_font_select"
                    android:background="@color/white"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15.0dp">
        <LinearLayout android:orientation="vertical"
                      android:background="@color/white"
                      android:layout_width="0.0dp"
                      android:layout_height="fill_parent"
                      android:layout_marginLeft="15.0dp"
                      android:layout_marginTop="5.0dp"
                      android:layout_marginBottom="5.0dp"
                      android:layout_weight="0.5"
                      android:layout_marginStart="15.0dp">
          <TextView android:textSize="12.0sp"
                    android:textColor="#666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/font" />
          <TextView android:textSize="16.0sp"
                    android:textColor="#999999"
                    android:id="@id/tv_text_font_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical"
                      android:background="@color/white"
                      android:layout_width="0.0dp"
                      android:layout_height="fill_parent"
                      android:layout_marginTop="5.0dp"
                      android:layout_marginBottom="5.0dp"
                      android:layout_weight="0.4">
          <TextView android:textSize="12.0sp"
                    android:textColor="#666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/style" />
          <TextView android:textSize="16.0sp"
                    android:textColor="#999999"
                    android:id="@id/tv_text_font_style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical"
                      android:background="@color/white"
                      android:layout_width="0.0dp"
                      android:layout_height="fill_parent"
                      android:layout_marginTop="5.0dp"
                      android:layout_marginRight="15.0dp"
                      android:layout_marginBottom="5.0dp"
                      android:layout_weight="0.1"
                      android:layout_marginEnd="15.0dp">
          <TextView android:textSize="12.0sp"
                    android:textColor="#666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/size" />
          <TextView android:textSize="16.0sp"
                    android:textColor="#999999"
                    android:id="@id/tv_text_font_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dp" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>