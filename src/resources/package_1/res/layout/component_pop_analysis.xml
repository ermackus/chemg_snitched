<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:gravity="center"
              android:orientation="vertical"
              android:background="@drawable/shape_analysis_pop"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:background="@drawable/shape_top_pop"
                android:layout_width="250.0dp"
                android:layout_height="40.0dp"
                android:paddingStart="10.0dp">
    <TextView android:textSize="14.0sp"
              android:textColor="#ff484848"
              android:gravity="center_vertical"
              android:layout_width="0.0dp"
              android:layout_height="fill_parent"
              android:text="@string/palette_chemical_property"
              android:layout_weight="1.0" />
    <ImageButton android:id="@id/ibt_paste"
                 android:background="#f3f3f3"
                 android:layout_width="40.0dp"
                 android:layout_height="fill_parent"
                 kingdraw:srcCompat="@drawable/ic_analysis_paste_selector" />
    <View android:background="@mipmap/line_function"
          android:layout_width="1.0dp"
          android:layout_height="fill_parent"
          android:layout_marginTop="5.0dp"
          android:layout_marginBottom="5.0dp" />
    <ImageButton android:id="@id/ibt_close"
                 android:background="#f3f3f3"
                 android:layout_width="40.0dp"
                 android:layout_height="fill_parent"
                 android:layout_marginEnd="5.0dp"
                 kingdraw:srcCompat="@drawable/ic_close_black_24dp_selector" />
  </LinearLayout>
  <LinearLayout android:orientation="vertical"
                android:background="@drawable/shape_bottom_pop"
                android:paddingBottom="10.0dp"
                android:layout_width="250.0dp"
                android:layout_height="fill_parent"
                android:paddingStart="10.0dp">
    <LinearLayout android:orientation="horizontal"
                  android:background="@color/white"
                  android:paddingTop="5.0dp"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginEnd="3.0dp">
      <TextView android:textSize="12.0sp"
                android:layout_gravity="center_vertical"
                android:layout_width="0.0dp"
                android:layout_height="wrap_content"
                android:text="@string/palette_decimal_number"
                android:layout_weight="0.45" />
      <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":" />
      <LinearLayout android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.55"
                    android:paddingStart="5.0dp">
        <TextView android:id="@id/tv_sub"
                  android:background="@drawable/ic_btn_num_sub_selector"
                  android:layout_width="30.0dp"
                  android:layout_height="24.0dp" />
        <TextView android:textSize="12.0sp"
                  android:textColor="@color/black"
                  android:gravity="center"
                  android:id="@id/tv_num"
                  android:background="@drawable/decimal_number_bg"
                  android:layout_width="24.0dp"
                  android:layout_height="24.0dp"
                  android:layout_marginLeft="1.0dp"
                  android:layout_marginRight="1.0dp" />
        <TextView android:id="@id/tv_add"
                  android:background="@drawable/ic_btn_num_add_selector"
                  android:layout_width="30.0dp"
                  android:layout_height="24.0dp" />
      </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="fill_parent"
                android:layout_height="fill_parent">
      <LinearLayout android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="5.0dp">
          <CheckBox android:textSize="12.0sp"
                    android:textColor="#757575"
                    android:id="@id/cb_formula"
                    android:layout_width="0.0dp"
                    android:layout_height="25.0dp"
                    android:checked="true"
                    android:text="Formula"
                    android:layout_weight="0.45" />
          <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":" />
          <TextView android:textSize="12.0sp"
                    android:id="@id/tv_formula"
                    android:paddingBottom="5.0dp"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.55"
                    android:paddingStart="5.0dp"
                    android:paddingEnd="3.0dp" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">
          <CheckBox android:textSize="12.0sp"
                    android:textColor="#757575"
                    android:id="@id/cb_exact_mass"
                    android:layout_width="0.0dp"
                    android:layout_height="25.0dp"
                    android:checked="true"
                    android:text="Exact Mass"
                    android:layout_weight="0.45" />
          <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":" />
          <TextView android:textSize="12.0sp"
                    android:id="@id/tv_exact_mass"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.55"
                    android:paddingStart="5.0dp"
                    android:paddingEnd="3.0dp" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">
          <CheckBox android:textSize="12.0sp"
                    android:textColor="#757575"
                    android:id="@id/cb_mol_wt"
                    android:layout_width="0.0dp"
                    android:layout_height="25.0dp"
                    android:checked="true"
                    android:text="Mol.Wt."
                    android:layout_weight="0.45" />
          <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":" />
          <TextView android:textSize="12.0sp"
                    android:id="@id/tv_mol_wt"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.55"
                    android:paddingStart="5.0dp"
                    android:paddingEnd="3.0dp" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">
          <CheckBox android:textSize="12.0sp"
                    android:textColor="#757575"
                    android:id="@id/cb_elem_anal"
                    android:layout_width="0.0dp"
                    android:layout_height="25.0dp"
                    android:text="Elem.Anal."
                    android:layout_weight="0.45" />
          <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":" />
          <TextView android:textSize="12.0sp"
                    android:id="@id/tv_elem_anal"
                    android:paddingBottom="5.0dp"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.55"
                    android:paddingStart="5.0dp"
                    android:paddingEnd="3.0dp" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">
          <RelativeLayout android:orientation="horizontal"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:layout_weight="0.45">
            <CheckBox android:textSize="12.0sp"
                      android:textColor="#757575"
                      android:id="@id/cb_mz"
                      android:layout_width="fill_parent"
                      android:layout_height="25.0dp"
                      android:text="m/z" />
            <RelativeLayout android:id="@id/rl_mz_pic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/cb_mz"
                            android:layout_marginStart="35.0dp"
                            android:layout_marginEnd="10.0dp" />
            <View android:layout_gravity="bottom|center"
                  android:id="@id/view_line"
                  android:background="@color/black"
                  android:layout_width="fill_parent"
                  android:layout_height="1.0dp"
                  android:layout_below="@id/rl_mz_pic"
                  android:layout_marginStart="30.0dp"
                  android:layout_marginEnd="5.0dp" />
          </RelativeLayout>
          <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":" />
          <TextView android:textSize="12.0sp"
                    android:gravity="center|start|top"
                    android:id="@id/tv_mz"
                    android:paddingBottom="5.0dp"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.55"
                    android:inputType="textMultiLine"
                    android:paddingStart="5.0dp" />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
  </LinearLayout>
</LinearLayout>