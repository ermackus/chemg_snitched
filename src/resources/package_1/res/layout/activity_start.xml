<?xml version='1.0' encoding='utf-8' ?>
<FrameLayout android:orientation="vertical"
             android:background="@color/white"
             android:layout_width="fill_parent"
             android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <FrameLayout android:layout_width="fill_parent"
               android:layout_height="fill_parent">
    <ImageView android:layout_gravity="center"
               android:layout_width="fill_parent"
               android:layout_height="fill_parent"
               android:layout_marginBottom="60.0dp"
               android:src="@drawable/start_bg"
               android:scaleType="fitXY" />
    <ImageView android:layout_gravity="right"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginRight="-25.0dp"
               android:src="@drawable/start_bg_benhuan" />
    <LinearLayout android:gravity="center"
                  android:layout_gravity="center"
                  android:orientation="vertical"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content">
      <ImageView android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:src="@drawable/start_title" />
      <ImageView android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="2.0dp"
                 android:src="@drawable/start_english" />
    </LinearLayout>
  </FrameLayout>
  <LinearLayout android:gravity="center"
                android:layout_gravity="bottom"
                android:layout_width="fill_parent"
                android:layout_height="90.0dp">
    <ImageView android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@drawable/start_logo" />
  </LinearLayout>
</FrameLayout>