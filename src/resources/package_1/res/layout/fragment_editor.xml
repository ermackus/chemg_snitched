<?xml version='1.0' encoding='utf-8' ?>
<FrameLayout android:orientation="vertical"
             android:background="@color/white"
             android:layout_width="fill_parent"
             android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
    <com.kingagroot.kingdraw.widget.FileTag.GTagLocalFilterView android:id="@id/file_tags"
                          android:background="@color/white"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content" />
    <FrameLayout android:layout_width="fill_parent"
                 android:layout_height="0.0dp"
                 android:layout_weight="1.0">
      <com.kingagroot.kingdraw.widget.GSwipeRefreshLayout android:id="@id/swiperefreshlayout"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent">
        <com.kingagroot.kingdraw.widget.MListView android:id="@id/list_data"
                              android:layout_width="fill_parent"
                              android:layout_height="fill_parent"
                              android:layout_margin="10.0dp"
                              android:divider="#00000000" />
      </com.kingagroot.kingdraw.widget.GSwipeRefreshLayout>
      <LinearLayout android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@id/rl_search_data_empty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20.0dp">
        <ImageView android:layout_gravity="center_horizontal"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   kingdraw:srcCompat="@drawable/ic_nodata" />
        <TextView android:textSize="14.0sp"
                  android:textColor="#666666"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="3.0dp"
                  android:text="@string/no_data" />
      </LinearLayout>
      <LinearLayout android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@id/ll_local_empty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-50.0dp">
        <ImageView android:layout_gravity="center_horizontal"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:src="@drawable/default_null" />
        <LinearLayout android:layout_gravity="center_horizontal"
                      android:orientation="horizontal"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content">
          <TextView android:textSize="14.0sp"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:id="@id/tv_new_build"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/palette_empty" />
        </LinearLayout>
      </LinearLayout>
    </FrameLayout>
    <com.kingagroot.kingdraw.widget.BatchOperateView android:id="@id/batch_view"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content" />
  </LinearLayout>
</FrameLayout>