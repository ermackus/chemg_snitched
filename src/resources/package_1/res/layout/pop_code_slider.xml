<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:orientation="vertical"
                android:background="@drawable/bg_radius_white_10"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_margin="10.0dp" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <WebView android:id="@id/web_code_slider"
           android:layout_width="fill_parent"
           android:layout_height="80.0dp"
           android:layout_margin="10.0dp"
           android:isScrollContainer="false" />
  <RelativeLayout android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="10.0dp"
                  android:layout_below="@id/web_code_slider"
                  android:layout_marginStart="10.0dp"
                  android:layout_marginEnd="10.0dp"
                  android:layout_alignStart="@id/web_code_slider"
                  android:layout_alignEnd="@id/web_code_slider">
    <ImageButton android:id="@id/ibt_slide_close"
                 android:background="@android:color/transparent"
                 android:layout_width="30.0dp"
                 android:layout_height="30.0dp"
                 android:layout_alignParentStart="true"
                 kingdraw:srcCompat="@drawable/ic_modal_close" />
    <ImageButton android:id="@id/ibt_slide_refresh"
                 android:background="@android:color/transparent"
                 android:layout_width="30.0dp"
                 android:layout_height="30.0dp"
                 android:layout_alignParentEnd="true"
                 kingdraw:srcCompat="@drawable/ic_modal_refresh" />
  </RelativeLayout>
</RelativeLayout>