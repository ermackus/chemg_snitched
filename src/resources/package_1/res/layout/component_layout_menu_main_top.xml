<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:gravity="center_vertical"
              android:orientation="horizontal"
              android:layout_width="fill_parent"
              android:layout_height="@dimen/home_tool_height"
              android:baselineAligned="false" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:gravity="center_vertical"
                android:id="@id/ll_content"
                android:background="@drawable/func_top_bg"
                android:layout_width="0.0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">
    <ImageButton android:id="@id/ibt_close"
                 android:background="@null"
                 android:layout_width="50.0dp"
                 android:layout_height="fill_parent"
                 android:paddingStart="5.0dp"
                 kingdraw:srcCompat="@drawable/ic_nav_back" />
    <TextView android:textSize="15.0sp"
              android:textColor="@android:color/black"
              android:ellipsize="end"
              android:id="@id/tv_filename"
              android:layout_width="80.0dp"
              android:layout_height="wrap_content"
              android:hint="@string/palette_unnamed"
              android:maxLines="1" />
    <HorizontalScrollView android:scrollbars="none"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent"
                          android:fillViewport="true">
      <LinearLayout android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent">
        <ImageButton android:id="@id/ibt_save"
                     android:background="@null"
                     android:padding="5.0dp"
                     android:layout_width="@dimen/home_tool_height"
                     android:layout_height="@dimen/home_tool_height"
                     android:scaleType="centerInside"
                     kingdraw:srcCompat="@drawable/ic_export" />
        <com.kingagroot.component.ui.view.GImageButton android:id="@id/ibt_save_as"
                              android:background="@null"
                              android:padding="5.0dp"
                              android:layout_width="@dimen/home_tool_height"
                              android:layout_height="@dimen/home_tool_height"
                              android:scaleType="centerInside"
                              kingdraw:CornerWidth="6.0dp"
                              kingdraw:VectorDrawable="@drawable/ic_save_as" />
        <ImageView android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:src="@mipmap/line_function" />
        <com.kingagroot.component.ui.menu.TopMenu android:id="@id/menu"
                              android:layout_width="fill_parent"
                              android:layout_height="fill_parent" />
      </LinearLayout>
    </HorizontalScrollView>
  </LinearLayout>
  <ImageView android:layout_width="wrap_content"
             android:layout_height="fill_parent"
             android:src="@mipmap/line_function" />
  <CheckBox android:id="@id/cb_full_screen"
            android:background="@drawable/func_top_bg"
            android:layout_width="@dimen/home_tool_height"
            android:layout_height="@dimen/home_tool_height"
            android:button="@drawable/checkbox_fullscreen_selector" />
</LinearLayout>