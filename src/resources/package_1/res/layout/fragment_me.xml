<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:background="@color/white"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical"
                android:id="@id/ll_user_top"
                android:background="@drawable/bg_me_vip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <ImageButton android:layout_gravity="end"
                 android:id="@id/ibt_setting"
                 android:background="@android:color/transparent"
                 android:layout_width="22.0dp"
                 android:layout_height="22.0dp"
                 android:layout_marginTop="50.0dp"
                 android:foreground="?android:attr/selectableItemBackground"
                 android:layout_marginEnd="20.0dp"
                 kingdraw:srcCompat="@drawable/ic_me_setting" />
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="80.0dp"
                  android:layout_alignParentBottom="true"
                  android:layout_marginStart="16.0dp">
      <RelativeLayout android:id="@id/ll_no_login"
                      android:visibility="gone"
                      android:layout_width="fill_parent"
                      android:layout_height="fill_parent">
        <ImageView android:id="@id/iv_head"
                   android:background="@android:color/transparent"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_margin="10.0dp"
                   android:layout_centerVertical="true"
                   kingdraw:srcCompat="@drawable/ic_user_no_login" />
        <LinearLayout android:orientation="vertical"
                      android:layout_width="wrap_content"
                      android:layout_height="fill_parent"
                      android:weightSum="2.0"
                      android:layout_toStartOf="@id/iv_next"
                      android:layout_toEndOf="@id/iv_head">
          <TextView android:textSize="18.0sp"
                    android:textColor="#ff000000"
                    android:gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="0.0dp"
                    android:text="@string/login_reg"
                    android:layout_weight="1.0" />
          <TextView android:textSize="12.0sp"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="0.0dp"
                    android:layout_marginTop="5.0dp"
                    android:text="@string/login_hint"
                    android:layout_weight="1.0" />
        </LinearLayout>
        <ImageView android:id="@id/iv_next"
                   android:background="@android:color/transparent"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="10.0dp"
                   android:layout_marginBottom="10.0dp"
                   android:layout_centerVertical="true"
                   android:layout_marginStart="10.0dp"
                   android:layout_marginEnd="10.0dp"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_me_next" />
      </RelativeLayout>
      <RelativeLayout android:id="@id/rl_login"
                      android:layout_width="fill_parent"
                      android:layout_height="fill_parent">
        <com.goodsrc.ui.library.widget.RoundAndCircleImageView android:id="@id/iv_user_login"
                              android:background="@android:color/transparent"
                              android:layout_width="60.0dp"
                              android:layout_height="60.0dp"
                              android:layout_marginTop="10.0dp"
                              android:layout_marginBottom="10.0dp"
                              android:layout_centerVertical="true"
                              android:layout_marginStart="10.0dp"
                              android:layout_marginEnd="10.0dp"
                              kingdraw:srcCompat="@drawable/ic_user_login" />
        <LinearLayout android:orientation="vertical"
                      android:id="@id/ll_user_info"
                      android:paddingRight="10.0dp"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_centerVertical="true"
                      android:layout_toStartOf="@id/iv_user_next"
                      android:layout_toEndOf="@id/iv_user_login">
          <TextView android:textSize="18.0sp"
                    android:textColor="#ff000000"
                    android:ellipsize="end"
                    android:id="@id/tv_user_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1" />
          <TextView android:textSize="12.0sp"
                    android:id="@id/tv_user_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_ordinary" />
        </LinearLayout>
        <ImageView android:id="@id/iv_user_next"
                   android:background="@android:color/transparent"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="10.0dp"
                   android:layout_marginBottom="10.0dp"
                   android:layout_centerVertical="true"
                   android:layout_marginStart="10.0dp"
                   android:layout_marginEnd="10.0dp"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_me_next" />
      </RelativeLayout>
    </LinearLayout>
    <RelativeLayout android:id="@id/rl_vip_center"
                    android:background="@0x7f080322"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dp"
                    android:layout_marginBottom="10.0dp"
                    android:minHeight="70.0dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="10.0dp"
                    android:layout_marginEnd="10.0dp"
                    android:layout_alignParentEnd="true">
      <TextView android:textSize="13.0sp"
                android:textColor="#fff15f5d"
                android:id="@id/tv_vip_center"
                android:background="@drawable/bg_radius_white_6"
                android:paddingTop="5.0dp"
                android:paddingBottom="5.0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vip_center"
                android:layout_centerVertical="true"
                android:paddingStart="8.0dp"
                android:paddingEnd="8.0dp"
                android:layout_marginEnd="16.0dp"
                android:layout_alignParentEnd="true" />
    </RelativeLayout>
  </LinearLayout>
  <RelativeLayout android:id="@id/rl_syn_list"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="45.0dp"
                  android:layout_marginTop="10.0dp"
                  android:foreground="?android:attr/selectableItemBackground">
    <TextView android:textSize="16.0sp"
              android:textColor="#ff000000"
              android:gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/synchronize"
              android:drawablePadding="10.0dp"
              android:layout_centerVertical="true"
              android:layout_marginStart="18.0dp"
              kingdraw:drawableStartCompat="@drawable/ic_syn_list" />
    <ImageView android:background="@android:color/transparent"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="10.0dp"
               android:layout_marginBottom="10.0dp"
               android:layout_centerVertical="true"
               android:layout_marginStart="10.0dp"
               android:layout_marginEnd="10.0dp"
               android:layout_alignParentEnd="true"
               kingdraw:srcCompat="@drawable/ic_me_next" />
  </RelativeLayout>
  <RelativeLayout android:id="@id/rl_scan"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="45.0dp"
                  android:foreground="?android:attr/selectableItemBackground">
    <TextView android:textSize="16.0sp"
              android:textColor="#ff000000"
              android:gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scan"
              android:drawablePadding="10.0dp"
              android:layout_centerVertical="true"
              android:layout_marginStart="18.0dp"
              kingdraw:drawableStartCompat="@drawable/ic_scan" />
    <ImageView android:background="@android:color/transparent"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="10.0dp"
               android:layout_marginBottom="10.0dp"
               android:layout_centerVertical="true"
               android:layout_marginStart="10.0dp"
               android:layout_marginEnd="10.0dp"
               android:layout_alignParentEnd="true"
               kingdraw:srcCompat="@drawable/ic_me_next" />
  </RelativeLayout>
  <View android:background="#ffefefef"
        android:layout_width="fill_parent"
        android:layout_height="1.0dp"
        android:layout_marginStart="18.0dp"
        android:layout_marginEnd="18.0dp" />
  <RelativeLayout android:id="@id/rl_share"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="45.0dp"
                  android:foreground="?android:attr/selectableItemBackground">
    <TextView android:textSize="16.0sp"
              android:textColor="#ff000000"
              android:gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/share_app"
              android:drawablePadding="10.0dp"
              android:layout_centerVertical="true"
              android:layout_marginStart="18.0dp"
              kingdraw:drawableStartCompat="@drawable/ic_share" />
    <ImageView android:background="@android:color/transparent"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="10.0dp"
               android:layout_marginBottom="10.0dp"
               android:layout_centerVertical="true"
               android:layout_marginStart="10.0dp"
               android:layout_marginEnd="10.0dp"
               android:layout_alignParentEnd="true"
               kingdraw:srcCompat="@drawable/ic_me_next" />
  </RelativeLayout>
  <RelativeLayout android:id="@id/rl_opinion"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="45.0dp"
                  android:foreground="?android:attr/selectableItemBackground">
    <TextView android:textSize="16.0sp"
              android:textColor="#ff000000"
              android:gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/feedback"
              android:drawablePadding="10.0dp"
              android:layout_centerVertical="true"
              android:layout_marginStart="18.0dp"
              kingdraw:drawableStartCompat="@drawable/ic_opinion" />
    <ImageView android:background="@android:color/transparent"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="10.0dp"
               android:layout_marginBottom="10.0dp"
               android:layout_centerVertical="true"
               android:layout_marginStart="10.0dp"
               android:layout_marginEnd="10.0dp"
               android:layout_alignParentEnd="true"
               kingdraw:srcCompat="@drawable/ic_me_next" />
  </RelativeLayout>
  <RelativeLayout android:id="@id/rl_help"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="45.0dp"
                  android:foreground="?android:attr/selectableItemBackground">
    <TextView android:textSize="16.0sp"
              android:textColor="#ff000000"
              android:gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/help"
              android:drawablePadding="10.0dp"
              android:layout_centerVertical="true"
              android:layout_marginStart="18.0dp"
              kingdraw:drawableStartCompat="@drawable/ic_help" />
    <ImageView android:background="@android:color/transparent"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="10.0dp"
               android:layout_marginBottom="10.0dp"
               android:layout_centerVertical="true"
               android:layout_marginStart="10.0dp"
               android:layout_marginEnd="10.0dp"
               android:layout_alignParentEnd="true"
               kingdraw:srcCompat="@drawable/ic_me_next" />
  </RelativeLayout>
  <View android:background="#ffefefef"
        android:layout_width="fill_parent"
        android:layout_height="1.0dp"
        android:layout_marginStart="18.0dp"
        android:layout_marginEnd="18.0dp" />
  <RelativeLayout android:id="@id/rl_about"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="45.0dp"
                  android:foreground="?android:attr/selectableItemBackground">
    <TextView android:textSize="16.0sp"
              android:textColor="#ff000000"
              android:gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/about_us"
              android:drawablePadding="10.0dp"
              android:layout_centerVertical="true"
              android:layout_marginStart="18.0dp"
              kingdraw:drawableStartCompat="@drawable/ic_item_about" />
    <TextView android:textSize="16.0sp"
              android:textColor="#ff666666"
              android:id="@id/tv_version"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_centerVertical="true"
              android:layout_toStartOf="@id/iv_next_about" />
    <ImageView android:id="@id/iv_next_about"
               android:background="@android:color/transparent"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="10.0dp"
               android:layout_marginBottom="10.0dp"
               android:layout_centerVertical="true"
               android:layout_marginStart="10.0dp"
               android:layout_marginEnd="10.0dp"
               android:layout_alignParentEnd="true"
               kingdraw:srcCompat="@drawable/ic_me_next" />
  </RelativeLayout>
  <RelativeLayout android:id="@id/rl_score"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="45.0dp"
                  android:foreground="?android:attr/selectableItemBackground">
    <TextView android:textSize="16.0sp"
              android:textColor="#ff000000"
              android:gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/rate"
              android:drawablePadding="10.0dp"
              android:layout_centerVertical="true"
              android:layout_marginStart="18.0dp"
              kingdraw:drawableStartCompat="@drawable/ic_score" />
    <ImageView android:background="@android:color/transparent"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="10.0dp"
               android:layout_marginBottom="10.0dp"
               android:layout_centerVertical="true"
               android:layout_marginStart="10.0dp"
               android:layout_marginEnd="10.0dp"
               android:layout_alignParentEnd="true"
               kingdraw:srcCompat="@drawable/ic_me_next" />
  </RelativeLayout>
</LinearLayout>