<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <RelativeLayout android:orientation="horizontal"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="45.0dp">
    <TextView android:textSize="14.0sp"
              android:textColor="@android:color/black"
              android:gravity="center_vertical"
              android:id="@id/tv_group"
              android:paddingLeft="20.0dp"
              android:layout_width="wrap_content"
              android:layout_height="fill_parent"
              android:text="@string/tags" />
    <ImageButton android:id="@id/imgbtn_clear"
                 android:background="?attr/actionBarItemBackground"
                 android:paddingLeft="12.0dp"
                 android:paddingRight="12.0dp"
                 android:layout_width="wrap_content"
                 android:layout_height="fill_parent"
                 android:layout_toRightOf="@id/tv_group"
                 kingdraw:srcCompat="@drawable/ic_tag_manager" />
    <TextView android:textSize="14.0sp"
              android:textColor="@color/color_999"
              android:gravity="center_vertical"
              android:id="@id/tv_tag_manage"
              android:background="?attr/actionBarItemBackground"
              android:layout_width="wrap_content"
              android:layout_height="fill_parent"
              android:layout_marginRight="20.0dp"
              android:text="@string/tag_screen"
              android:drawablePadding="5.0dp"
              android:layout_alignParentRight="true"
              android:layout_centerVertical="true"
              kingdraw:drawableLeftCompat="@drawable/ic_tag_screen" />
  </RelativeLayout>
  <View android:background="@color/line"
        android:layout_width="fill_parent"
        android:layout_height="0.5dp" />
  <LinearLayout android:background="@color/white"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <com.kingagroot.kingdraw.widget.FileTag.LocalScrollView android:id="@id/scrollView"
                          android:scrollbars="none"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent">
      <com.kingagroot.kingdraw.widget.FileTag.FileTagGroup android:id="@id/file_tag_group"
                            android:paddingLeft="20.0dp"
                            android:paddingTop="10.0dp"
                            android:paddingRight="20.0dp"
                            android:paddingBottom="10.0dp"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />
    </com.kingagroot.kingdraw.widget.FileTag.LocalScrollView>
  </LinearLayout>
  <View android:background="@drawable/shadow"
        android:layout_width="fill_parent"
        android:layout_height="4.0dp" />
</LinearLayout>