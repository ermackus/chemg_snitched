<?xml version='1.0' encoding='utf-8' ?>
<ScrollView android:background="@drawable/shape_edit_table"
            android:layout_width="200.0dp"
            android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <ImageView android:layout_gravity="center_horizontal"
               android:id="@id/img_sup"
               android:background="@android:color/white"
               android:layout_width="55.0dp"
               android:layout_height="55.0dp"
               android:layout_marginTop="10.0dp"
               android:scaleType="fitCenter"
               android:contentDescription="@null" />
    <TextView android:textSize="12.0sp"
              android:textColor="#666666"
              android:gravity="center"
              android:layout_gravity="center"
              android:id="@id/tv_dialog_sup_name"
              android:paddingLeft="5.0dp"
              android:paddingRight="5.0dp"
              android:paddingBottom="2.0dp"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="5.0dp" />
    <View android:background="#f3f3f3"
          android:layout_width="fill_parent"
          android:layout_height="0.5dp" />
    <TextView android:textSize="14.0sp"
              android:textColor="#333333"
              android:id="@id/btn_set_common"
              android:background="@color/white"
              android:layout_width="fill_parent"
              android:layout_height="45.0dp"
              android:text="@string/sup_set_common"
              style="@style/Widget.AppCompat.ActionButton" />
    <TextView android:textSize="14.0sp"
              android:textColor="#333333"
              android:id="@id/btn_cancel_common"
              android:background="@color/white"
              android:visibility="gone"
              android:layout_width="fill_parent"
              android:layout_height="45.0dp"
              android:text="@string/sup_cancel_common"
              style="@style/Widget.AppCompat.ActionButton" />
    <View android:background="#f3f3f3"
          android:layout_width="fill_parent"
          android:layout_height="0.5dp" />
    <TextView android:textSize="14.0sp"
              android:textColor="#333333"
              android:id="@id/btn_sup_edit"
              android:background="@color/white"
              android:layout_width="fill_parent"
              android:layout_height="45.0dp"
              android:text="@string/edit"
              style="@style/Widget.AppCompat.ActionButton" />
    <View android:background="#f3f3f3"
          android:layout_width="fill_parent"
          android:layout_height="0.5dp" />
    <TextView android:textSize="14.0sp"
              android:textColor="#333333"
              android:id="@id/btn_sup_delete"
              android:background="@color/white"
              android:layout_width="fill_parent"
              android:layout_height="45.0dp"
              android:text="@string/delete"
              style="@style/Widget.AppCompat.ActionButton" />
    <View android:background="#f3f3f3"
          android:layout_width="fill_parent"
          android:layout_height="0.5dp" />
    <TextView android:textSize="14.0sp"
              android:textColor="#333333"
              android:id="@id/btn_sup_cancel"
              android:background="@color/white"
              android:layout_width="fill_parent"
              android:layout_height="45.0dp"
              android:text="@string/cancel"
              style="@style/Widget.AppCompat.ActionButton" />
  </LinearLayout>
</ScrollView>