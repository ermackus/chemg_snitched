<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:id="@id/welcome_fragment"
              android:background="@color/white"
              android:paddingTop="30.0dp"
              android:clipChildren="false"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:layout_weight="6.0" xmlns:android="http://schemas.android.com/apk/res/android">
  <FrameLayout android:clipChildren="false"
               android:layout_width="fill_parent"
               android:layout_height="0.0dp"
               android:layout_weight="4.0">
    <ImageView android:layout_gravity="bottom|center"
               android:paddingLeft="16.0dp"
               android:paddingRight="16.0dp"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@drawable/guide_img4"
               android:scaleType="centerInside" />
  </FrameLayout>
  <TextView android:textSize="30.0sp"
            android:textStyle="bold"
            android:textColor="#fffc595b"
            android:gravity="center"
            android:id="@id/heading"
            android:paddingLeft="24.0dp"
            android:paddingRight="24.0dp"
            android:layout_width="fill_parent"
            android:layout_height="0.0dp"
            android:text="@string/guide_four_title"
            android:layout_weight="1.0"
            android:textAllCaps="true" />
  <TextView android:textSize="16.0sp"
            android:gravity="center|top"
            android:id="@id/content"
            android:paddingLeft="24.0dp"
            android:paddingRight="24.0dp"
            android:layout_width="fill_parent"
            android:layout_height="0.0dp"
            android:text="@string/guide_four_content"
            android:layout_weight="1.0" />
  <View android:background="@android:color/transparent"
        android:layout_width="fill_parent"
        android:layout_height="60.0dp" />
</LinearLayout>