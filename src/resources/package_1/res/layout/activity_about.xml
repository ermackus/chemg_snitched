<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:background="#f8f8f8"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <ImageView android:layout_gravity="center"
               android:layout_width="88.0dp"
               android:layout_height="88.0dp"
               android:layout_marginTop="40.0dp"
               android:src="@mipmap/ic_launcher" />
    <TextView android:textSize="12.0sp"
              android:textColor="#666666"
              android:layout_gravity="center"
              android:id="@id/tv_version"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="10.0dp"
              android:text="@string/ver_hint" />
    <TextView android:textSize="12.0sp"
              android:textColor="#999999"
              android:gravity="center_horizontal"
              android:layout_gravity="center"
              android:paddingLeft="5.0dp"
              android:paddingTop="5.0dp"
              android:paddingRight="5.0dp"
              android:paddingBottom="5.0dp"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="10.0dp"
              android:text="@string/our_wish"
              android:lineSpacingExtra="3.0dp" />
    <LinearLayout android:orientation="vertical"
                  android:background="@color/white"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="10.0dp"
                  android:foreground="?android:attr/selectableItemBackground">
      <RelativeLayout android:id="@id/rl_user_ser"
                      android:layout_width="fill_parent"
                      android:layout_height="45.0dp"
                      android:foreground="?android:attr/selectableItemBackground">
        <TextView android:textSize="14.0sp"
                  android:textColor="#333333"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="15.0dp"
                  android:text="@string/user_ser_agreement"
                  android:layout_alignParentLeft="true"
                  android:layout_centerVertical="true"
                  android:layout_alignParentStart="true" />
        <ImageView android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginRight="10.0dp"
                   android:layout_alignParentRight="true"
                   android:layout_centerVertical="true"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
      </RelativeLayout>
      <View android:background="#d9d9d9"
            android:layout_width="fill_parent"
            android:layout_height="1.0dp"
            android:layout_marginLeft="15.0dp" />
      <RelativeLayout android:id="@id/rl_privacy"
                      android:layout_width="fill_parent"
                      android:layout_height="45.0dp"
                      android:foreground="?android:attr/selectableItemBackground">
        <TextView android:textSize="14.0sp"
                  android:textColor="#333333"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="15.0dp"
                  android:text="@string/pri_agreement"
                  android:layout_alignParentLeft="true"
                  android:layout_centerVertical="true"
                  android:layout_alignParentStart="true" />
        <ImageView android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginRight="10.0dp"
                   android:layout_alignParentRight="true"
                   android:layout_centerVertical="true"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
      </RelativeLayout>
      <View android:background="#d9d9d9"
            android:layout_width="fill_parent"
            android:layout_height="1.0dp"
            android:layout_marginLeft="15.0dp" />
      <RelativeLayout android:id="@id/rl_disclaimer"
                      android:layout_width="fill_parent"
                      android:layout_height="45.0dp"
                      android:foreground="?android:attr/selectableItemBackground">
        <TextView android:textSize="14.0sp"
                  android:textColor="#333333"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="15.0dp"
                  android:text="@string/disclaimer"
                  android:layout_alignParentLeft="true"
                  android:layout_centerVertical="true"
                  android:layout_alignParentStart="true" />
        <ImageView android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginRight="10.0dp"
                   android:layout_alignParentRight="true"
                   android:layout_centerVertical="true"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
      </RelativeLayout>
      <View android:background="#d9d9d9"
            android:layout_width="fill_parent"
            android:layout_height="1.0dp"
            android:layout_marginLeft="15.0dp" />
      <RelativeLayout android:id="@id/rl_contact_us"
                      android:layout_width="fill_parent"
                      android:layout_height="45.0dp"
                      android:foreground="?android:attr/selectableItemBackground">
        <TextView android:textSize="14.0sp"
                  android:textColor="#333333"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="15.0dp"
                  android:text="@string/contact_us"
                  android:layout_alignParentLeft="true"
                  android:layout_centerVertical="true"
                  android:layout_alignParentStart="true" />
        <ImageView android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginRight="10.0dp"
                   android:layout_alignParentRight="true"
                   android:layout_centerVertical="true"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
      </RelativeLayout>
      <View android:background="#d9d9d9"
            android:layout_width="fill_parent"
            android:layout_height="1.0dp"
            android:layout_marginLeft="15.0dp" />
      <RelativeLayout android:id="@id/rl_app_update"
                      android:layout_width="fill_parent"
                      android:layout_height="45.0dp"
                      android:foreground="?android:attr/selectableItemBackground">
        <TextView android:textSize="14.0sp"
                  android:textColor="#333333"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="15.0dp"
                  android:text="@string/app_update"
                  android:layout_alignParentLeft="true"
                  android:layout_centerVertical="true"
                  android:layout_alignParentStart="true" />
        <ImageView android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginRight="10.0dp"
                   android:layout_alignParentRight="true"
                   android:layout_centerVertical="true"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
      </RelativeLayout>
    </LinearLayout>
  </LinearLayout>
  <TextView android:textSize="20.0sp"
            android:textColor="#6b000000"
            android:id="@id/release"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50.0dp"
            android:layout_above="@id/tv_com_info"
            android:layout_centerHorizontal="true" />
  <TextView android:textSize="12.0sp"
            android:textColor="#ffd9d9d9"
            android:gravity="center"
            android:id="@id/tv_com_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5.0dp"
            android:lines="2"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true" />
</RelativeLayout>