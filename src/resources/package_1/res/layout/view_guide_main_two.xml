<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:weightSum="4.0" xmlns:android="http://schemas.android.com/apk/res/android">
  <FrameLayout android:background="@drawable/bg_radius_all_white_10"
               android:padding="6.0dp"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_above="@id/iv_triangle"
               android:layout_marginEnd="20.0dp"
               android:layout_alignParentEnd="true">
    <TextView android:textSize="14.0sp"
              android:textColor="#ff000000"
              android:gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="36.0dp"
              android:text="@string/main_guide_two" />
    <Button android:textSize="14.0sp"
            android:textColor="@android:color/white"
            android:layout_gravity="right"
            android:id="@id/btn_got"
            android:background="@drawable/btn_blue_guide_selector"
            android:layout_width="wrap_content"
            android:layout_height="30.0dp"
            android:layout_marginTop="50.0dp"
            android:text="@string/got_it" />
  </FrameLayout>
  <ImageView android:id="@id/iv_triangle"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginBottom="60.0dp"
             android:src="@drawable/triangle_down"
             android:layout_alignParentBottom="true"
             android:layout_marginEnd="45.0dp"
             android:layout_alignParentEnd="true" />
</RelativeLayout>