<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="horizontal"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <androidx.drawerlayout.widget.DrawerLayout android:id="@id/dl_palette"
                        android:background="@color/white"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
    <FrameLayout android:id="@id/fl_common"
                 android:layout_width="fill_parent"
                 android:layout_height="fill_parent">
      <com.kingagroot.kingdraw.core.view.KingDrawView android:id="@id/king_draw"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent" />
      <com.kingagroot.component.ui.menu.ElementMenuView android:layout_gravity="center_vertical"
                            android:id="@id/palette_menu_element"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="50.0dp"
                            android:layout_marginBottom="50.0dp" />
      <com.kingagroot.kingdraw.core.view.MagnifierView android:id="@id/magnifier"
                            android:background="@mipmap/magnifier_bg"
                            android:padding="5.0dp"
                            android:layout_width="140.0dp"
                            android:layout_height="100.0dp"
                            android:layout_marginTop="45.0dp"
                            android:layout_marginStart="45.0dp" />
      <com.kingagroot.component.ui.view.HintView android:layout_gravity="center|start|top"
                            android:id="@id/tv_hint"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="45.0dp"
                            android:paddingStart="5.0dp"
                            android:layout_marginStart="45.0dp" />
    </FrameLayout>
    <FrameLayout android:id="@id/fl_portrait"
                 android:layout_width="fill_parent"
                 android:layout_height="fill_parent">
      <com.kingagroot.component.ui.vertical.VerticalRightToolView android:layout_gravity="right"
                            android:id="@id/vertical_right_tool"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent" />
      <com.kingagroot.component.ui.vertical.VerticalBottomToolView android:layout_gravity="bottom"
                            android:id="@id/vertical_bottom_tool"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />
      <com.kingagroot.component.ui.vertical.VerticalTopToolView android:layout_gravity="top"
                            android:id="@id/vertical_top_tool"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />
    </FrameLayout>
    <FrameLayout android:id="@id/fl_landscape"
                 android:visibility="gone"
                 android:layout_width="fill_parent"
                 android:layout_height="fill_parent">
      <com.kingagroot.component.ui.menu.PaletteOtherView android:layout_gravity="right"
                            android:id="@id/land_right_tool"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent" />
      <com.kingagroot.component.ui.menu.PaletteBottomView android:layout_gravity="bottom"
                            android:id="@id/land_bottom_tool"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />
      <com.kingagroot.component.ui.menu.MainPaletteTopMenu android:layout_gravity="top"
                            android:id="@id/land_top_tool"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />
    </FrameLayout>
    <com.kingagroot.component.ui.widget.richinput.InputMenuContainer android:id="@id/input_menu"
                          android:background="@android:color/transparent"
                          android:focusable="true"
                          android:visibility="invisible"
                          android:clickable="true"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent" />
    <com.kingagroot.component.ui.widget.sup.SupCollectView android:layout_gravity="center|right"
                          android:id="@id/sup_collect"
                          android:layout_width="220.0dp"
                          android:layout_height="fill_parent" />
  </androidx.drawerlayout.widget.DrawerLayout>
</LinearLayout>