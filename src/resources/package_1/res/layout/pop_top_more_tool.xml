<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <androidx.cardview.widget.CardView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="3.0dp"
                        kingdraw:cardBackgroundColor="@android:color/white"
                        kingdraw:cardCornerRadius="0.0dp"
                        kingdraw:cardElevation="3.0dp">
    <LinearLayout android:orientation="vertical"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:minWidth="150.0dp">
      <LinearLayout android:id="@id/ll_pop_top_save"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dp"
                    style="@style/Widget.AppCompat.ActionButton">
        <ImageView android:layout_gravity="center_vertical"
                   android:layout_width="20.0dp"
                   android:layout_height="20.0dp"
                   android:layout_marginEnd="7.0dp"
                   kingdraw:srcCompat="@drawable/ic_export" />
        <TextView android:textColor="@android:color/black"
                  android:gravity="center_vertical"
                  android:layout_width="0.0dp"
                  android:layout_height="40.0dp"
                  android:text="@string/save"
                  android:singleLine="true"
                  android:layout_weight="1.0" />
      </LinearLayout>
      <LinearLayout android:id="@id/ll_pop_top_save_as"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dp"
                    style="@style/Widget.AppCompat.ActionButton">
        <ImageView android:layout_gravity="center_vertical"
                   android:layout_width="20.0dp"
                   android:layout_height="20.0dp"
                   android:layout_marginEnd="7.0dp"
                   kingdraw:srcCompat="@drawable/ic_save_as" />
        <TextView android:textColor="@android:color/black"
                  android:gravity="center_vertical"
                  android:layout_width="0.0dp"
                  android:layout_height="40.0dp"
                  android:text="@string/export_as"
                  android:singleLine="true"
                  android:layout_weight="1.0" />
      </LinearLayout>
      <LinearLayout android:id="@id/ll_pop_top_palette_setting"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dp"
                    style="@style/Widget.AppCompat.ActionButton">
        <ImageView android:layout_gravity="center_vertical"
                   android:layout_width="20.0dp"
                   android:layout_height="20.0dp"
                   android:layout_marginEnd="7.0dp"
                   kingdraw:srcCompat="@drawable/ic_draw_fileset_nor" />
        <TextView android:textColor="@android:color/black"
                  android:gravity="center_vertical"
                  android:layout_width="0.0dp"
                  android:layout_height="40.0dp"
                  android:text="@string/setting"
                  android:singleLine="true"
                  android:layout_weight="1.0" />
      </LinearLayout>
      <LinearLayout android:id="@id/ll_pop_top_help"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dp"
                    style="@style/Widget.AppCompat.ActionButton">
        <ImageView android:layout_gravity="center_vertical"
                   android:layout_width="20.0dp"
                   android:layout_height="20.0dp"
                   android:layout_marginEnd="7.0dp"
                   kingdraw:srcCompat="@mipmap/ic_doc" />
        <TextView android:textColor="@android:color/black"
                  android:gravity="center_vertical"
                  android:layout_width="0.0dp"
                  android:layout_height="40.0dp"
                  android:text="@string/palette_help"
                  android:singleLine="true"
                  android:layout_weight="1.0" />
      </LinearLayout>
      <LinearLayout android:orientation="horizontal"
                    android:id="@id/ll_pop_top_share"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dp"
                    style="@style/Widget.AppCompat.ActionButton">
        <ImageView android:layout_gravity="center_vertical"
                   android:layout_width="20.0dp"
                   android:layout_height="20.0dp"
                   android:layout_marginEnd="5.0dp"
                   kingdraw:srcCompat="@drawable/ic_share_black" />
        <TextView android:textColor="@android:color/black"
                  android:gravity="center_vertical"
                  android:layout_width="0.0dp"
                  android:layout_height="40.0dp"
                  android:text="@string/share"
                  android:layout_weight="1.0" />
      </LinearLayout>
    </LinearLayout>
  </androidx.cardview.widget.CardView>
</LinearLayout>