<?xml version='1.0' encoding='utf-8' ?>
<FrameLayout android:descendantFocusability="blocksDescendants"
             android:layout_width="fill_parent"
             android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <RelativeLayout android:layout_gravity="center"
                  android:id="@id/rl_value"
                  android:background="@drawable/bg_radius_white_10"
                  android:layout_width="80.0dp"
                  android:layout_height="80.0dp"
                  android:layout_margin="5.0dp">
    <ImageView android:id="@id/iv_item"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_centerInParent="true"
               kingdraw:srcCompat="@drawable/ic_bond_single" />
    <com.kingagroot.kingdraw.widget.CenterCheckBox android:gravity="center"
                          android:id="@id/chb_item"
                          android:clickable="false"
                          android:layout_width="20.0dp"
                          android:layout_height="20.0dp"
                          android:layout_margin="5.0dp"
                          android:button="@null"
                          android:layout_alignParentTop="true"
                          android:drawableStart="@drawable/check_box_cicle"
                          android:layout_alignParentEnd="true" />
  </RelativeLayout>
</FrameLayout>