<?xml version='1.0' encoding='utf-8' ?>
<FrameLayout android:orientation="vertical"
             android:background="@color/white"
             android:layout_width="fill_parent"
             android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
    <com.kingagroot.kingdraw.widget.GSwipeRefreshLayout android:id="@id/swiperefreshlayout"
                          android:layout_width="fill_parent"
                          android:layout_height="0.0dp"
                          android:layout_weight="1.0">
      <com.kingagroot.kingdraw.widget.MListView android:id="@id/listview"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_margin="10.0dp"
                            android:divider="#00000000" />
    </com.kingagroot.kingdraw.widget.GSwipeRefreshLayout>
    <com.kingagroot.kingdraw.widget.BatchOperateView android:id="@id/batch_view"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content" />
  </LinearLayout>
  <LinearLayout android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/empty_view"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="160.0dp">
    <ImageView android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               kingdraw:srcCompat="@drawable/ic_cloud_ic" />
    <TextView android:textSize="14.0sp"
              android:gravity="center_horizontal"
              android:id="@id/tv_empty"
              android:layout_width="300.0dp"
              android:layout_height="wrap_content" />
  </LinearLayout>
  <LinearLayout android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/ll_empty_search_cloud"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="180.0dp">
    <ImageView android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               kingdraw:srcCompat="@drawable/ic_search_nodate" />
    <TextView android:textSize="14.0sp"
              android:textColor="#bcbcbc"
              android:id="@id/tv_empty_search_cloud"
              android:paddingLeft="20.0dp"
              android:paddingRight="20.0dp"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="5.0dp" />
  </LinearLayout>
</FrameLayout>