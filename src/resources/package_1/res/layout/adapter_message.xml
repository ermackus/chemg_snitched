<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:foreground="?android:attr/selectableItemBackground" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/iv_next"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/iv_next">
    <RelativeLayout android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp">
      <TextView android:ellipsize="end"
                android:id="@id/tv_message_title"
                android:paddingRight="5.0dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15.0dp"
                android:lines="1"
                android:layout_toLeftOf="@id/tv_message_date"
                android:layout_centerVertical="true"
                android:paddingEnd="5.0dp"
                android:layout_marginStart="15.0dp"
                android:layout_toStartOf="@id/tv_message_date" />
      <TextView android:id="@id/tv_message_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5.0dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5.0dp"
                android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp">
      <ImageView android:id="@id/iv_message"
                 android:layout_width="5.0dp"
                 android:layout_height="5.0dp"
                 android:layout_marginRight="5.0dp"
                 android:layout_alignParentRight="true"
                 android:layout_centerVertical="true"
                 android:layout_marginEnd="5.0dp"
                 android:layout_alignParentEnd="true"
                 kingdraw:srcCompat="@drawable/ic_msg_unread" />
      <TextView android:ellipsize="end"
                android:id="@id/tv_message_info"
                android:paddingLeft="15.0dp"
                android:paddingRight="5.0dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_toLeftOf="@id/iv_message"
                android:layout_centerVertical="true"
                android:paddingEnd="5.0dp"
                android:layout_toStartOf="@id/iv_message" />
    </RelativeLayout>
  </LinearLayout>
  <ImageView android:id="@id/iv_next"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginRight="10.0dp"
             android:layout_alignParentRight="true"
             android:layout_centerVertical="true"
             android:layout_alignParentEnd="true"
             kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
  <View android:background="@color/line"
        android:layout_width="fill_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true" />
</RelativeLayout>