<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:layout_marginLeft="30.0dp"
              android:layout_marginRight="30.0dp" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <FrameLayout android:background="@drawable/bg_version_round"
               android:layout_width="fill_parent"
               android:layout_height="wrap_content">
    <ImageView android:layout_width="fill_parent"
               android:layout_height="wrap_content"
               android:layout_marginTop="25.0dp"
               android:scaleType="fitXY"
               kingdraw:srcCompat="@drawable/ic_cloud_img_bg" />
  </FrameLayout>
  <LinearLayout android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/bg_login_buttom"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-45.0dp">
    <ImageView android:layout_gravity="center_horizontal"
               android:layout_width="70.0dp"
               android:layout_height="70.0dp"
               kingdraw:srcCompat="@drawable/ic_cloud" />
    <TextView android:textSize="16.0sp"
              android:textColor="#333333"
              android:layout_gravity="center_horizontal"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="10.0dp"
              android:text="@string/cloud_storage" />
    <TextView android:textSize="12.0sp"
              android:textColor="#666666"
              android:gravity="center"
              android:padding="5.0dp"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:text="@string/storage_info" />
    <Button android:id="@id/btn_login"
            android:layout_marginTop="20.0dp"
            android:text="@string/login_now"
            style="@style/button_style" />
    <Button android:textSize="12.0sp"
            android:textColor="#999999"
            android:id="@id/btn_no_login"
            android:background="@null"
            android:layout_width="fill_parent"
            android:layout_height="45.0dp"
            android:text="@string/login_later" />
  </LinearLayout>
</LinearLayout>