<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:gravity="center"
              android:orientation="horizontal"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <FrameLayout android:id="@id/frame_icon"
               android:paddingLeft="20.0dp"
               android:paddingTop="10.0dp"
               android:paddingRight="5.0dp"
               android:paddingBottom="10.0dp"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginLeft="-30.0dp">
    <ImageView android:id="@id/img_bg"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               kingdraw:srcCompat="@drawable/ic_cloud_black_bg" />
    <ImageView android:layout_gravity="center|top"
               android:id="@id/img_down"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               kingdraw:srcCompat="@drawable/ic_down" />
  </FrameLayout>
  <TextView android:id="@id/tv_tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cloud" />
</LinearLayout>