<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <com.kingagroot.kingdraw.utils.GToolBar android:id="@id/toolbar"
                        android:layout_width="fill_parent"
                        android:layout_height="50.0dp" />
  <View android:background="@drawable/shadow"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/show_height" />
  <LinearLayout android:id="@id/ll_notch"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@id/swiperefreshlayout"
                          android:visibility="gone"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent">
      <WebView android:id="@id/web_view"
               android:layout_width="fill_parent"
               android:layout_height="fill_parent"
               android:overScrollMode="never" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
  </LinearLayout>
  <ImageView android:layout_gravity="center"
             android:id="@id/iv_no_network"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginTop="88.0dp"
             kingdraw:srcCompat="@0x7f080282" />
</LinearLayout>