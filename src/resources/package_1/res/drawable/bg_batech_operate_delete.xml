<?xml version='1.0' encoding='utf-8' ?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_enabled="false">
    <shape>
      <corners android:topLeftRadius="5.0dp"
               android:topRightRadius="5.0dp"
               android:bottomLeftRadius="5.0dp"
               android:bottomRightRadius="5.0dp" />
      <stroke android:width="1.0dp"
              android:color="#88e13e3f" />
      <solid android:color="#ffffff" />
    </shape>
  </item>
  <item android:state_pressed="true">
    <shape>
      <corners android:topLeftRadius="5.0dp"
               android:topRightRadius="5.0dp"
               android:bottomLeftRadius="5.0dp"
               android:bottomRightRadius="5.0dp" />
      <stroke android:width="1.0dp"
              android:color="#88e13e3f" />
      <solid android:color="#ffffff" />
    </shape>
  </item>
  <item android:state_pressed="false">
    <shape>
      <corners android:topLeftRadius="5.0dp"
               android:topRightRadius="5.0dp"
               android:bottomLeftRadius="5.0dp"
               android:bottomRightRadius="5.0dp" />
      <stroke android:width="1.0dp"
              android:color="@color/main_red" />
      <solid android:color="#ffffff" />
    </shape>
  </item>
</selector>