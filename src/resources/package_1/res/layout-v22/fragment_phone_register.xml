<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:background="@color/white"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat android:orientation="vertical"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          kingdraw:divider="@drawable/line_f1"
                          kingdraw:dividerPadding="15.0dp"
                          kingdraw:showDividers="end|middle">
      <LinearLayout android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="60.0dp"
                    android:layout_marginLeft="15.0dp"
                    android:layout_marginRight="15.0dp">
        <TextView android:textSize="16.0sp"
                  android:textColor="@color/black"
                  android:gravity="center|left"
                  android:paddingLeft="5.0dp"
                  android:layout_width="wrap_content"
                  android:layout_height="fill_parent"
                  android:text="@string/area" />
        <TextView android:textSize="16.0sp"
                  android:textColor="#ff666666"
                  android:ellipsize="middle"
                  android:gravity="center|left"
                  android:id="@id/tv_country"
                  android:padding="5.0dp"
                  android:layout_width="fill_parent"
                  android:layout_height="fill_parent"
                  android:singleLine="true"
                  kingdraw:drawableRightCompat="@drawable/ic_chevron_right_black_24dp" />
      </LinearLayout>
      <LinearLayout android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="60.0dp"
                    android:layout_marginLeft="15.0dp"
                    android:layout_marginRight="15.0dp">
        <LinearLayout android:layout_gravity="center"
                      android:orientation="horizontal"
                      android:layout_width="0.0dp"
                      android:layout_height="fill_parent"
                      android:layout_weight="0.2">
          <TextView android:textSize="16.0sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:paddingStart="5.0dp" />
          <EditText android:textSize="16.0sp"
                    android:textColor="@color/black"
                    android:gravity="center|start"
                    android:id="@id/et_area_code"
                    android:background="@android:color/transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="86"
                    android:maxLength="6"
                    android:inputType="number"
                    android:importantForAutofill="no" />
        </LinearLayout>
        <com.kingagroot.component.ui.view.ClearEditText android:textSize="16.0sp"
                              android:textColor="#ff333333"
                              android:textColorHint="#ded9d9d9"
                              android:id="@id/et_register_phone"
                              android:background="@android:color/transparent"
                              android:padding="5.0dp"
                              android:layout_width="0.0dp"
                              android:layout_height="fill_parent"
                              android:hint="@string/enter_phone"
                              android:layout_weight="0.8"
                              android:inputType="phone"
                              android:importantForAutofill="no" />
      </LinearLayout>
      <LinearLayout android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="60.0dp"
                    android:layout_marginLeft="15.0dp"
                    android:layout_marginRight="15.0dp">
        <TextView android:textSize="16.0sp"
                  android:textColor="@color/black"
                  android:gravity="center|left"
                  android:paddingLeft="5.0dp"
                  android:layout_width="0.0dp"
                  android:layout_height="fill_parent"
                  android:text="@string/verification_code"
                  android:layout_weight="0.2" />
        <RelativeLayout android:layout_width="0.0dp"
                        android:layout_height="fill_parent"
                        android:layout_weight="0.8">
          <EditText android:textSize="16.0sp"
                    android:textColor="#ff333333"
                    android:textColorHint="#ded9d9d9"
                    android:ellipsize="end"
                    android:gravity="center|start"
                    android:id="@id/et_register_code"
                    android:background="@android:color/transparent"
                    android:padding="5.0dp"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:hint="@string/enter_code"
                    android:lines="1"
                    android:maxLength="8"
                    android:digits="0123456789"
                    android:inputType="number"
                    android:layout_toStartOf="@id/btn_register_send_code"
                    android:importantForAutofill="no" />
          <androidx.appcompat.widget.AppCompatButton android:textColor="@color/white"
                                android:id="@id/btn_register_send_code"
                                android:background="@drawable/btn_usual_selector"
                                android:layout_width="wrap_content"
                                android:layout_height="40.0dp"
                                android:text="@string/send_code"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true" />
        </RelativeLayout>
      </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="15.0dp"
                  android:layout_marginTop="16.0dp"
                  android:layout_marginRight="15.0dp">
      <CheckBox android:textSize="12.0sp"
                android:textColor="#ff999999"
                android:gravity="center"
                android:id="@id/check_register_agree"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:checked="false"
                android:text="@string/read_agree"
                style="@style/Widget.AppCompat.CompoundButton.CheckBox" />
      <TextView android:textSize="14.0sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@id/tv_register_agreement"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:maxLines="5"
                android:lineSpacingExtra="2.0dp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:textSize="16.0sp"
                          android:textColor="@color/white"
                          android:id="@id/btn_register"
                          android:background="@drawable/btn_usual_selector"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:layout_marginTop="10.0dp"
                          android:text="@string/register"
                          android:layout_marginStart="15.0dp"
                          android:layout_marginEnd="15.0dp" />
  </LinearLayout>
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dp"
                android:layout_alignParentBottom="true">
    <RelativeLayout android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
      <View android:layout_centerInParent="true"
            android:layout_toStartOf="@id/tv_other_way"
            style="@style/login_line" />
      <TextView android:textSize="16.0sp"
                android:textColor="#ff999999"
                android:gravity="center"
                android:id="@id/tv_other_way"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/other_way_reg"
                android:layout_centerInParent="true" />
      <View android:layout_centerInParent="true"
            android:layout_toEndOf="@id/tv_other_way"
            style="@style/login_line" />
    </RelativeLayout>
    <ImageButton android:layout_gravity="center"
                 android:id="@id/ibt_register_email"
                 android:background="@android:color/transparent"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="10.0dp"
                 kingdraw:srcCompat="@drawable/ic_register_email" />
    <TextView android:textSize="16.0sp"
              android:textColor="#ff706b6b"
              android:gravity="center"
              android:layout_gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="6.0dp"
              android:text="@string/email" />
  </LinearLayout>
</RelativeLayout>