<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <ScrollView android:layout_width="fill_parent"
              android:layout_height="fill_parent">
    <LinearLayout android:orientation="vertical"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <RelativeLayout android:id="@id/rl_gesture"
                      android:background="@color/white"
                      android:layout_width="fill_parent"
                      android:layout_height="45.0dp"
                      android:foreground="?android:attr/selectableItemBackground">
        <TextView android:textSize="14.0sp"
                  android:textColor="#ff484848"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="15.0dp"
                  android:text="@string/gesture_edit"
                  android:layout_toLeftOf="@id/img_arrow"
                  android:layout_alignParentLeft="true"
                  android:layout_centerVertical="true"
                  android:layout_marginStart="15.0dp"
                  android:layout_toStartOf="@id/img_arrow"
                  android:layout_alignParentStart="true" />
        <ImageView android:id="@id/img_arrow"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginRight="10.0dp"
                   android:layout_alignParentRight="true"
                   android:layout_centerVertical="true"
                   android:contentDescription="@string/next"
                   android:layout_marginEnd="10.0dp"
                   android:layout_alignParentEnd="true"
                   kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
      </RelativeLayout>
      <View style="@style/hline" />
      <LinearLayout android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <LinearLayout style="@style/Setting_layout">
          <TextView android:text="@string/bond_check"
                    style="@style/Setting_tv_in" />
          <androidx.appcompat.widget.SwitchCompat android:id="@id/switch_check"
                                android:layout_width="0.0dp"
                                android:layout_height="fill_parent"
                                android:checked="true"
                                android:layout_weight="0.3"
                                android:paddingEnd="15.0dp" />
        </LinearLayout>
        <View android:layout_marginStart="15.0dp"
              style="@style/hline" />
        <LinearLayout style="@style/Setting_layout">
          <TextView android:text="@string/magnifier"
                    style="@style/Setting_tv_in" />
          <androidx.appcompat.widget.SwitchCompat android:id="@id/switch_loupe"
                                android:layout_width="0.0dp"
                                android:layout_height="fill_parent"
                                android:checked="true"
                                android:layout_weight="0.3"
                                android:paddingEnd="15.0dp" />
        </LinearLayout>
        <View android:layout_marginStart="15.0dp"
              style="@style/hline" />
        <LinearLayout style="@style/Setting_layout">
          <TextView android:text="@string/guide_line"
                    style="@style/Setting_tv_in" />
          <androidx.appcompat.widget.SwitchCompat android:id="@id/switch_guides"
                                android:layout_width="0.0dp"
                                android:layout_height="fill_parent"
                                android:checked="true"
                                android:layout_weight="0.3"
                                android:paddingEnd="15.0dp" />
        </LinearLayout>
      </LinearLayout>
      <View android:layout_marginStart="15.0dp"
            style="@style/hline" />
      <LinearLayout android:layout_height="wrap_content"
                    android:minHeight="40.0dp"
                    style="@style/Setting_layout">
        <LinearLayout android:layout_gravity="center_vertical"
                      android:orientation="vertical"
                      android:layout_width="0.0dp"
                      android:layout_height="wrap_content"
                      android:layout_weight="0.7"
                      android:paddingStart="15.0dp">
          <TextView android:textSize="14.0sp"
                    android:textColor="#484848"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_atom_color" />
          <TextView android:textSize="12.0sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_atom_color_hint" />
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat android:id="@id/switch_color"
                              android:layout_width="0.0dp"
                              android:layout_height="fill_parent"
                              android:checked="true"
                              android:layout_weight="0.3"
                              android:paddingEnd="15.0dp" />
      </LinearLayout>
      <TextView android:text="@string/show_carbon"
                style="@style/Setting_tv_out" />
      <RelativeLayout android:background="@color/white"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginBottom="20.0dp"
                      android:minHeight="40.0dp">
        <RadioGroup android:orientation="horizontal"
                    android:background="@drawable/bg_check_c_normal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10.0dp"
                    android:weightSum="3.0"
                    android:layout_centerInParent="true">
          <RadioButton android:textSize="14.0sp"
                       android:gravity="center"
                       android:id="@id/rbt_show"
                       android:background="@drawable/bg_check_c"
                       android:paddingTop="10.0dp"
                       android:paddingBottom="10.0dp"
                       android:layout_width="0.0dp"
                       android:layout_height="fill_parent"
                       android:button="@null"
                       android:text="@string/carbon_show"
                       android:layout_weight="1.0" />
          <RadioButton android:textSize="14.0sp"
                       android:gravity="center"
                       android:id="@id/rbt_hide"
                       android:background="@drawable/bg_check_c"
                       android:paddingTop="10.0dp"
                       android:paddingBottom="10.0dp"
                       android:layout_width="0.0dp"
                       android:layout_height="fill_parent"
                       android:button="@null"
                       android:text="@string/carbon_hide"
                       android:layout_weight="1.0" />
          <RadioButton android:textSize="14.0sp"
                       android:gravity="center"
                       android:id="@id/rbt_end"
                       android:background="@drawable/bg_check_c"
                       android:paddingTop="10.0dp"
                       android:paddingBottom="10.0dp"
                       android:layout_width="0.0dp"
                       android:layout_height="fill_parent"
                       android:button="@null"
                       android:text="@string/carbon_end"
                       android:layout_weight="1.0" />
        </RadioGroup>
      </RelativeLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>