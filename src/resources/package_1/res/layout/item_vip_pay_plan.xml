<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:id="@id/ll_item_plan"
              android:background="@drawable/bg_white_round_shadow_5"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:layout_margin="5.0dp" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10.0dp"
                android:weightSum="7.0">
    <TextView android:textSize="11.0sp"
              android:textColor="#ff333333"
              android:layout_gravity="center"
              android:id="@id/tv_vip_plan_name"
              android:layout_width="0.0dp"
              android:layout_height="wrap_content"
              android:maxLines="2"
              android:layout_weight="3.0" />
    <TextView android:textSize="11.0sp"
              android:textColor="#ffaaaaaa"
              android:gravity="center"
              android:layout_gravity="center"
              android:id="@id/tv_vip_plan_info"
              android:background="#fff3f3f3"
              android:padding="2.0dp"
              android:layout_width="0.0dp"
              android:layout_height="wrap_content"
              android:lines="1"
              android:layout_weight="2.0" />
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="0.0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="2.0">
      <TextView android:layout_width="0.0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
      <TextView android:textSize="12.0sp"
                android:textColor="#ff333333"
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:id="@id/tv_vip_plan_money_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
      <TextView android:textSize="20.0sp"
                android:textColor="#ff333333"
                android:layout_gravity="bottom"
                android:id="@id/tv_vip_plan_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:textSize="11.0sp"
            android:textColor="#ffaaaaaa"
            android:layout_gravity="center"
            android:id="@id/tv_vip_plan_remark"
            android:padding="2.0dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14.0dp"
            android:layout_marginStart="9.0dp"
            android:layout_marginEnd="9.0dp" />
</LinearLayout>