<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:background="#f8f8f8"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:kingdraw="http://schemas.android.com/apk/res-auto">
  <androidx.appcompat.widget.LinearLayoutCompat android:orientation="vertical"
                        android:background="@color/white"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        kingdraw:divider="@drawable/line_f1"
                        kingdraw:dividerPadding="15.0dp"
                        kingdraw:showDividers="end|middle">
    <RelativeLayout android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dp"
                    android:layout_marginRight="15.0dp">
      <TextView android:textSize="16.0sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:paddingLeft="5.0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/head_img"
                android:layout_centerVertical="true" />
      <com.goodsrc.ui.library.widget.RoundAndCircleImageView android:gravity="center"
                            android:id="@id/iv_user_head"
                            android:layout_width="60.0dp"
                            android:layout_height="60.0dp"
                            android:layout_marginTop="5.0dp"
                            android:layout_marginBottom="5.0dp"
                            android:layout_marginStart="5.0dp"
                            android:layout_marginEnd="5.0dp"
                            android:layout_toStartOf="@id/iv_next" />
      <ImageView android:id="@id/iv_next"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_centerVertical="true"
                 android:layout_alignParentEnd="true"
                 kingdraw:srcCompat="@drawable/ic_chevron_right_black_24dp" />
    </RelativeLayout>
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="60.0dp"
                  android:layout_marginLeft="15.0dp"
                  android:layout_marginRight="15.0dp">
      <TextView android:textSize="16.0sp"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nickname"
                android:paddingStart="5.0dp" />
      <EditText android:textSize="16.0sp"
                android:textColor="#ff333333"
                android:textColorHint="#ded9d9d9"
                android:gravity="center|end"
                android:id="@id/et_user_nickname"
                android:background="@android:color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:maxLength="16"
                android:drawablePadding="5.0dp"
                kingdraw:drawableRightCompat="@drawable/ic_chevron_right_black_24dp" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="60.0dp"
                  android:layout_marginLeft="15.0dp"
                  android:layout_marginRight="15.0dp">
      <TextView android:textSize="16.0sp"
                android:textColor="@color/black"
                android:gravity="center|left"
                android:paddingLeft="5.0dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/sex" />
      <TextView android:gravity="center|end"
                android:id="@id/tv_user_sex"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:drawablePadding="5.0dp"
                kingdraw:drawableRightCompat="@drawable/ic_chevron_right_black_24dp" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="60.0dp"
                  android:layout_marginLeft="15.0dp"
                  android:layout_marginRight="15.0dp">
      <TextView android:textSize="16.0sp"
                android:textColor="@color/black"
                android:gravity="center|left"
                android:paddingLeft="5.0dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/occupation" />
      <TextView android:gravity="center|end"
                android:id="@id/tv_user_occupation"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:drawablePadding="5.0dp"
                kingdraw:drawableRightCompat="@drawable/ic_chevron_right_black_24dp" />
    </LinearLayout>
  </androidx.appcompat.widget.LinearLayoutCompat>
  <LinearLayout android:orientation="horizontal"
                android:background="@color/white"
                android:paddingLeft="15.0dp"
                android:paddingRight="15.0dp"
                android:layout_width="fill_parent"
                android:layout_height="60.0dp"
                android:layout_marginTop="20.0dp">
    <TextView android:textSize="16.0sp"
              android:textColor="@color/black"
              android:gravity="center|left"
              android:paddingLeft="5.0dp"
              android:layout_width="wrap_content"
              android:layout_height="fill_parent"
              android:text="@string/area" />
    <TextView android:textColor="#ffd9d9d9"
              android:gravity="center|end"
              android:id="@id/tv_user_country"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:drawablePadding="5.0dp" />
  </LinearLayout>
  <androidx.appcompat.widget.AppCompatButton android:textSize="16.0sp"
                        android:textColor="@color/white"
                        android:id="@id/btn_user_info"
                        android:background="@drawable/btn_usual_selector"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40.0dp"
                        android:text="@string/save"
                        android:layout_marginStart="15.0dp"
                        android:layout_marginEnd="15.0dp" />
</LinearLayout>